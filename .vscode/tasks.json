    },
    {
      "label": "Gate: generated guard (JEV)",
      "detail": "python3 -m tools.jev generated guard --base origin/main — no main-only generated file edited on this branch",
      "type": "shell",
      "command": "python3 -m tools.jev generated guard --base origin/main",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: workflows lint",
      "detail": "tools/dash workflows lint --strict — the workflow atlas holds the hub's workflows to the standards",
      "type": "shell",
      "command": "tools/dash workflows lint --strict",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
