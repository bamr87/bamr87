{
  // ==========================================================================
  // Tasks — the silent helpers launch.json leans on, and the hub gate.
  //
  // Same rule as launch.json: a task calls `tools/dash` or a tool's own entry
  // point, never a second implementation. Three kinds live here:
  //
  //   ensure / bootstrap   preLaunch helpers (silent): the shared core, a
  //                        project's debug layer, the console's venv and page
  //                        deps, Playwright for verify, a compile in devenv
  //   gates (group test)   the hub gate from AGENTS.md "Stack & commands" —
  //                        drift, schema, docs index, prose, specs, catalog,
  //                        JEV generated guard, workflows lint, governance,
  //                        shellcheck, actionlint, the test runners
  //   fleet / docker       up, down, logs, rebuild, port sync, Django chores
  //
  // Ports and project names come from the registries (_data/ports.yml,
  // _data/fleet.yml, .gitmodules), never from here.
  // ==========================================================================
  "version": "2.0.0",
  "tasks": [
    // ----------------------------------------------------------------- FLEET
    {
      "label": "Fleet: up core",
      "detail": "tools/dash up — devenv, console (:4001), db, redis on the `fleet` network (docs/CONTAINERS.md)",
      "type": "shell",
      "command": "tools/dash up",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: up core + traces",
      "detail": "tools/dash up --profile traces — the core plus Phoenix (:6006)",
      "type": "shell",
      "command": "tools/dash up --profile traces",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: up core + docs",
      "detail": "tools/dash up --profile docs — the core plus MkDocs (:8001) and Wiki.js (:3000)",
      "type": "shell",
      "command": "tools/dash up --profile docs",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: down core",
      "detail": "tools/dash down — stop the shared core (projects stay up; `tools/dash down --all` for everything)",
      "type": "shell",
      "command": "tools/dash down",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: ps",
      "detail": "tools/dash ps — every container fleet-wide and who is on the network",
      "type": "shell",
      "command": "tools/dash ps",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Fleet: sync port allocation",
      "detail": "tools/fleet-compose.py sync — regenerate compose/fleet.env + compose/overrides/ from _data/ports.yml (drift check m)",
      "type": "shell",
      "command": "tools/fleet-compose.py sync",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    // The attach entries' preLaunch: the project's stack with its debugpy layer.
    // law-ai and fredgar-ai ship a docker-compose.debug.yml that --debug layers in;
    // djangoerp's MAIN compose is already debug-capable behind DEBUGPY_ENABLE.
