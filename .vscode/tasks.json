      "label": "Fleet: dev up law-ai (debug)",
      "detail": "tools/dash dev up law-ai --debug — backend debugpy :5713, worker :5714",
      "type": "shell",
      "command": "tools/dash dev up law-ai --debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: dev up fredgar-ai (debug)",
      "detail": "tools/dash dev up fredgar-ai --debug — web debugpy :5712",
      "type": "shell",
      "command": "tools/dash dev up fredgar-ai --debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: dev up djangoerp (debug)",
      "detail": "DEBUGPY_ENABLE=1 tools/dash dev up djangoerp — web debugpy :5710, worker :5711",
      "type": "shell",
      "command": "tools/dash dev up djangoerp",
      "options": { "cwd": "${workspaceFolder}", "env": { "DEBUGPY_ENABLE": "1" } },
