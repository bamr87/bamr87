{
  // ==================================================
  // UNIFIED VS CODE TASKS - Docker-First Development
  // ==================================================
  // Optimized for it-journey, zer0-mistakes, barodybroject
  // Last Updated: 2025-10-26
  
  "version": "2.0.0",
  "tasks": [
    
    // ==========================================
    // CORE DOCKER OPERATIONS
    // ==========================================
    // ---------------------------------------------------------------- FLEET
    // tools/fleet-dev.sh is the single entry point for the dev stack: it
    // ensures `fleet-net` and .env.fleet exist, then drives each project as its
    // own compose project. See docs/FLEET-COMPOSE.md.
    {
      "label": "Fleet: up hub",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["up", "hub"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: up all",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["up", "--all"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: down all",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["down", "--all"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: ps",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["ps", "--all"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Fleet: sync port allocation",
      "type": "shell",
      "command": "tools/fleet-compose.py",
      "args": ["sync"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    // djangoerp ships no docker-compose.debug.yml: its MAIN compose is already
    // debug-capable and only needs the switch thrown, hence the env var rather
    // than a --debug layer.
    {
      "label": "Fleet: up djangoerp (debug)",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["up", "djangoerp"],
      "options": { "cwd": "${workspaceFolder}", "env": { "DEBUGPY_ENABLE": "1" } },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: up law-ai (debug)",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["up", "law-ai", "--debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Fleet: up fredgar-ai (debug)",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["up", "fredgar-ai", "--debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Docker: Compose Up (Detached)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Start Docker containers in detached mode"
    },

    {
      "label": "Docker: Compose Stop",
      "type": "shell", 
      "command": "docker",
      "args": ["compose", "stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Stop running Docker containers"
    },

    {
      "label": "Docker: Compose Down",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "down"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Stop and remove Docker containers, networks"
    },

    {
      "label": "Docker: Rebuild (Force)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build", "--force-recreate", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Force rebuild and recreate all Docker containers"
    },

    {
      "label": "Docker: Ensure devenv",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "devenv"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Start only the devenv workspace container (repo mounted at /workspace)"
    },

    {
      "label": "Docker: Ensure console",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "console"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Start the Harness Console container on 127.0.0.1:4001"
    },

    {
      "label": "Docker: Ensure mkdocs",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "mkdocs"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Start the MkDocs container for projects/README on :8001"
    },

    {
      "label": "Docker: Ensure phoenix",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "phoenix"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Start Arize Phoenix on 127.0.0.1:6006"
    },

    {
      "label": "Docker: Ensure lake stack",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "devenv", "phoenix"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Start devenv + Phoenix for dash-gen lake sync/export"
    },

    {
      "label": "devenv: compile csv-vscoode",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "-T", "-w", "/workspace/projects/csv-vscoode", "devenv", "npm", "run", "compile"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Docker: Ensure devenv",
      "problemMatcher": [],
      "detail": "Compile csv-vscoode inside devenv before Extension Host"
    },
    {
      "label": "devenv: compile vs-sonic-pi",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "-T", "-w", "/workspace/projects/vs-sonic-pi", "devenv", "npm", "run", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Docker: Ensure devenv",
      "problemMatcher": [],
      "detail": "Build vs-sonic-pi inside devenv before Extension Host"
    },
    {
      "label": "devenv: compile zpl-viewer",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "-T", "-w", "/workspace/projects/zpl-viewer", "devenv", "npm", "run", "compile"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Docker: Ensure devenv",
      "problemMatcher": [],
      "detail": "Compile zpl-viewer inside devenv before Extension Host"
    },
    {
      "label": "devenv: compile zer0-cms",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "-T", "-w", "/workspace/projects/zer0-cms", "devenv", "npm", "run", "compile"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Docker: Ensure devenv",
      "problemMatcher": [],
      "detail": "Compile zer0-cms inside devenv before Extension Host"
    },

    {
      "label": "Docker: View Logs",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "logs", "-f", "--tail=100"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": [],
      "detail": "Follow Docker container logs in real-time"
    },

    // ==========================================
    // APPLICATION SPECIFIC TASKS
    // ==========================================
    {
      "label": "Jekyll: Build Site",
      "type": "shell",
      // Was `docker-compose exec jekyll ...`: the hub's compose has no
      // `jekyll` service (that is barodybroject's name), so this never ran.
      "command": "tools/fleet-dev.sh",
      "args": ["exec", "zer0-mistakes", "jekyll", "bundle", "exec", "jekyll", "build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "dependsOn": "Docker: Compose Up (Detached)",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Build Jekyll site inside Docker container"
    },

    {
      "label": "Django: Run Migrations",
      "type": "shell",
      // Was `docker-compose exec web ...`: no `web` service in the hub's
      // compose. djangoerp is the Django app the hub actually drives.
      "command": "tools/fleet-dev.sh",
      "args": ["exec", "djangoerp", "web", "python", "manage.py", "migrate"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "dependsOn": "Docker: Compose Up (Detached)",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Run Django database migrations in Docker"
    },

    {
      "label": "Django: Create Superuser",
      "type": "shell",
      "command": "tools/fleet-dev.sh",
      "args": ["exec", "djangoerp", "web", "python", "manage.py", "createsuperuser"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "dependsOn": "Docker: Compose Up (Detached)",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Create Django superuser in Docker container"
    },

    // ==========================================
    // TESTING TASKS
    // ==========================================
    {
      "label": "Test: Run All Tests",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "${input:serviceContext}", "${input:testCommand}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "dependsOn": "Docker: Compose Up (Detached)",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Run test suite in Docker container"
    },

    {
      "label": "Lint: Run All Linters",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "${input:serviceContext}", "${input:lintCommand}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "dependsOn": "Docker: Compose Up (Detached)",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Run linting tools in Docker container"
    },

    // ==========================================
    // MAINTENANCE TASKS
    // ==========================================
    {
      "label": "Docker: Clean Up",
      "type": "shell",
      "command": "docker",
      "args": ["system", "prune", "-f"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      },
      "problemMatcher": [],
      "detail": "Clean up Docker system (containers, networks, images)"
    },

    {
      "label": "Dependencies: Update",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "exec", "${input:serviceContext}", "${input:updateCommand}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "dependsOn": "Docker: Compose Up (Detached)",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Update project dependencies in Docker container"
    },

    // ==========================================
    // MARKDOWN LINTING
    // ==========================================
    {
      "type": "markdownlint",
      "problemMatcher": ["$markdownlint"],
      "label": "Lint: Markdown Files",
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": false
      },
      "detail": "Lint all Markdown files with markdownlint"
    }
  ],

  // ==========================================
  // INPUT VARIABLES
  // ==========================================
  "inputs": [
    {
      "id": "serviceContext",
      "description": "Docker service context",
      "type": "pickString",
      "options": [
        "jekyll",
        "web",
        "app"
      ],
      "default": "jekyll"
    },
    {
      "id": "testCommand",
      "description": "Test command to run",
      "type": "pickString", 
      "options": [
        "bundle exec rspec",
        "python src/manage.py test",
        "pytest",
        "npm test"
      ],
      "default": "bundle exec rspec"
    },
    {
      "id": "lintCommand",
      "description": "Lint command to run",
      "type": "pickString",
      "options": [
        "rubocop",
        "flake8 src/",
        "black --check src/",
        "eslint ."
      ],
      "default": "rubocop"
    },
    {
      "id": "updateCommand", 
      "description": "Update command to run",
      "type": "pickString",
      "options": [
        "bundle update",
        "pip install -r requirements.txt",
        "npm update"
      ],
      "default": "bundle update"
    }
  ]
}