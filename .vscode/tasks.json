      "dependsOn": ["Console: bootstrap venv"],
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test: dash-gen (all fixture tests)",
      "detail": "Every .github/scripts/dash-gen/test_*.py as the plain scripts they are (offline fixtures)",
      "type": "shell",
      "command": "for t in .github/scripts/dash-gen/test_*.py; do .venv-console/bin/python \"$t\" || exit 1; done",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Console: bootstrap venv"],
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test: current file (native)",
