    // --------------------------------------------------------------- CONSOLE
    {
      "label": "Console: ensure compose service",
      "detail": "tools/dash console --docker — the long-lived Harness Console on 127.0.0.1:4001",
      "type": "shell",
      "command": "tools/dash console --docker",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      // Mirrors tools/console/run.sh's bootstrap (venv + requirements at
      // latest) without starting the server, and adds pytest — the one
      // pytest-only suite is test_cv_fragment.py. Skips the install when the
      // venv already imports what the debug entries need, so F5 stays quick.
      "label": "Console: bootstrap venv",
      "detail": ".venv-console: create if missing, install tools/console/requirements.txt + pytest if anything is missing",
      "type": "shell",
      "command": "test -x .venv-console/bin/python || python3 -m venv .venv-console; if ! .venv-console/bin/python -c 'import fastapi, uvicorn, yaml, github, pytest' 2>/dev/null; then .venv-console/bin/pip install --quiet --upgrade pip && .venv-console/bin/pip install --quiet --upgrade -r tools/console/requirements.txt pytest; fi",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Console: upgrade venv (always-latest)",
      "detail": "Re-resolve .venv-console to the newest published versions, exactly as run.sh does on every start",
      "type": "shell",
      "command": "python3 -m venv .venv-console && .venv-console/bin/pip install --quiet --upgrade pip && .venv-console/bin/pip install --quiet --upgrade -r tools/console/requirements.txt pytest",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Console: web install",
      "detail": "tools/console/web: npm install (no lockfile) when node_modules is missing",
      "type": "shell",
      "command": "[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund --loglevel=error",
      "options": { "cwd": "${workspaceFolder}/tools/console/web" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      // Background: VS Code waits for Vite's "Local:" line before launching
      // the browser entry that depends on this task.
      "label": "Console: web dev server (→ compose console :4001)",
      "detail": "Vite on :5173 with hot reload, /api proxied to the compose console",
      "type": "shell",
      "command": "npx vite",
      "options": { "cwd": "${workspaceFolder}/tools/console/web", "env": { "CONSOLE_URL": "http://127.0.0.1:4001" } },
      "dependsOn": ["Console: web install"],
      "isBackground": true,
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "dedicated", "showReuseMessage": false, "clear": true },
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": { "activeOnStart": true, "beginsPattern": "VITE v|vite v", "endsPattern": "Local:|ready in" }
      }
    },
    {
      "label": "Console: web dev server (→ debug API :4004)",
      "detail": "Vite on :5173 with hot reload, /api proxied to the natively debugged console on :4004",
      "type": "shell",
      "command": "npx vite",
      "options": { "cwd": "${workspaceFolder}/tools/console/web", "env": { "CONSOLE_URL": "http://127.0.0.1:4004" } },
      "dependsOn": ["Console: web install"],
      "isBackground": true,
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "dedicated", "showReuseMessage": false, "clear": true },
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": ".", "file": 1, "location": 2, "message": 3 }],
        "background": { "activeOnStart": true, "beginsPattern": "VITE v|vite v", "endsPattern": "Local:|ready in" }
      }
    },
    {
      "label": "Console: web build",
      "detail": "tools/console/web → dist/ (what app.py serves); run.sh does this on start",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/tools/console/web" },
      "dependsOn": ["Console: web install"],
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Console: web typecheck",
      "detail": "tsc -b --noEmit on the page",
      "type": "shell",
      "command": "npm run typecheck",
      "options": { "cwd": "${workspaceFolder}/tools/console/web" },
      "dependsOn": ["Console: web install"],
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": ["$tsc"]
    },

    // --------------------------------------------------------------- OBSERVE
    {
      "label": "Observe: up",
      "detail": "tools/dash observe up — ELK + Grafana + Qdrant + OTel collector + Prometheus, then ILM + dashboards",
      "type": "shell",
      "command": "tools/dash observe up",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },

    // ---------------------------------------------------------------- VERIFY
    {
      // verify/runner.mjs needs @playwright/test + yaml at the repo root and a
      // Chromium. No package.json here on purpose (fleet policy: no lockfiles),
      // so the install is --no-save; node_modules/ is gitignored.
      "label": "Verify: install Playwright",
      "detail": "Install @playwright/test + yaml (no-save) and Chromium when missing",
      "type": "shell",
      "command": "[ -x node_modules/.bin/playwright ] || npm install --no-save --no-package-lock --no-audit --no-fund --loglevel=error @playwright/test yaml; npx playwright install chromium",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "silent", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },

    // ------------------------------------------------------------- WORKSPACE
    // Compile a VS Code extension inside devenv before the Extension Host
    // (which is VS Code itself and so runs on the host).
    {
      "label": "devenv: compile vs-sonic-pi",
      "detail": "npm run build inside devenv (installs node_modules there on first use)",
      "type": "shell",
      "command": "docker compose exec -T -w /workspace/projects/vs-sonic-pi devenv sh -c '[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund; npm run build'",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Fleet: up core"],
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "devenv: compile zpl-viewer",
      "detail": "npm run compile inside devenv (installs node_modules there on first use)",
      "type": "shell",
      "command": "docker compose exec -T -w /workspace/projects/zpl-viewer devenv sh -c '[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund; npm run compile'",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Fleet: up core"],
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "devenv: compile zer0-cms",
      "detail": "npm run compile inside devenv (installs node_modules there on first use)",
      "type": "shell",
      "command": "docker compose exec -T -w /workspace/projects/zer0-cms devenv sh -c '[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund; npm run compile'",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Fleet: up core"],
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "devenv: bundle install (pick a submodule)",
      "detail": "Install a Jekyll site's gems inside devenv (gems live in the bundle-gems volume, never on the host)",
      "type": "shell",
      "command": "docker compose exec -T -w /workspace/projects/${input:submodule} devenv bundle install",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Fleet: up core"],
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "devenv: npm install (pick a submodule)",
      "detail": "Install a Node project's dependencies inside devenv (Linux binaries; the host's node_modules would not run there)",
      "type": "shell",
      "command": "docker compose exec -T -w /workspace/projects/${input:submodule} devenv npm install --no-package-lock --no-audit --no-fund",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["Fleet: up core"],
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Django: migrate (djangoerp)",
      "detail": "tools/dash dev exec djangoerp web python manage.py migrate",
      "type": "shell",
      "command": "tools/dash dev exec djangoerp web python manage.py migrate",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "clear": false },
      "problemMatcher": []
    },
    {
      "label": "Django: createsuperuser (djangoerp)",
      "detail": "tools/dash dev exec djangoerp web python manage.py createsuperuser",
      "type": "shell",
      "command": "tools/dash dev exec djangoerp web python manage.py createsuperuser",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "shared", "clear": false },
      "problemMatcher": []
    },

    // ----------------------------------------------------------------- GATES
    // AGENTS.md: a change is done when check-drift is green, the focused tests
    // pass, the nearest README/SCHEMA say what changed, and generated
    // projections are regenerated. These are those checks, one task each.
    {
      "label": "Gate: drift (report)",
      "detail": "tools/check-drift.sh --report — every check, never fails the shell",
      "type": "shell",
      "command": "tools/check-drift.sh --report",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: drift (full)",
      "detail": "tools/check-drift.sh — the gating checks, non-zero on failure (as CI runs it)",
      "type": "shell",
      "command": "tools/check-drift.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test: run all (tools/run-all-tests.sh)",
      "detail": "Root checks + dash-gen + console + every checked-out submodule suite whose deps are present",
      "type": "shell",
      "command": "tools/dash test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: schema lint",
      "detail": "python3 tools/schema_lint.py check . — the SCHEMA.md pyramid (warnings fail the gate too; --fix for mechanical drift)",
      "type": "shell",
      "command": "python3 tools/schema_lint.py check .",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: docs index",
      "detail": "python3 tools/docs_index.py --check — docs/README.md index is fresh (main-only file: never commit it from a PR)",
      "type": "shell",
      "command": "python3 tools/docs_index.py --check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: prose (current file)",
      "detail": "python3 tools/unwrap-prose.py --check <file> — one paragraph per line (--write fixes)",
      "type": "shell",
      "command": "python3 tools/unwrap-prose.py --check \"${relativeFile}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: specs data",
      "detail": "python3 tools/gen-specs-data.py --check — _data/specs.yml matches specs/",
      "type": "shell",
      "command": "python3 tools/gen-specs-data.py --check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: catalog (main only)",
      "detail": "python3 tools/gen-catalog.py --check — CATALOG.md is regenerated on main; a PR never commits it",
      "type": "shell",
      "command": "python3 tools/gen-catalog.py --check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
