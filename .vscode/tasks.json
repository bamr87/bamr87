      "command": "python3 tools/governance_lint.py check .",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Gate: shellcheck",
      "detail": "shellcheck tools/*.sh tools/observability/*.sh (gcc-style output → Problems panel)",
      "type": "shell",
      "command": "shellcheck -f gcc tools/*.sh tools/observability/*.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Gate: actionlint",
      "detail": "actionlint .github/workflows/*.yml",
      "type": "shell",
      "command": "actionlint .github/workflows/*.yml",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": true },
      "problemMatcher": []
    },
    {
      // Everything above that runs offline, in order, stopping at the first failure.
      "label": "Gate: all offline checks",
      "detail": "drift (report) → schema → docs index → specs → catalog → generated guard → workflows lint → governance → shellcheck → actionlint",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Gate: drift (report)",
        "Gate: schema lint",
        "Gate: docs index",
        "Gate: specs data",
        "Gate: catalog (main only)",
        "Gate: generated guard (JEV)",
        "Gate: workflows lint",
        "Gate: governance lint",
        "Gate: shellcheck",
        "Gate: actionlint"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: console",
      "detail": "Every tools/console/test_*.py, dependency-light, with .venv-console",
      "type": "shell",
      "command": "for t in test_console test_pages test_mcp_layer test_gh_projects test_subscription test_claude_telemetry test_tui_bridge test_health_autostart; do .venv-console/bin/python tools/console/$t.py || exit 1; done",
