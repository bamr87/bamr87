{
  // ==========================================================================
  // Recommended extensions — the union of what .devcontainer/devcontainer.json
  // installs in devenv and what launch.json / tasks.json rely on, kept in
  // one list so the host and the container agree.
  // ==========================================================================
  "recommendations": [
    // The harness: Claude Code, Copilot, GitHub
    "anthropic.claude-code",
    "github.copilot",
    "github.copilot-chat",
    "github.vscode-github-actions",
    "github.vscode-pull-request-github",
    "eamodio.gitlens",

    // Containers (Compose v2) and the dev container
    "ms-azuretools.vscode-containers",
    "ms-vscode-remote.remote-containers",

    // Python: the console, the generators, the hub tools (debugpy = the launch type)
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",

    // The console's page (React + TypeScript) and the verify kit
    "dbaeumer.vscode-eslint",
    "esbenp.prettier-vscode",
    "ms-playwright.playwright",
    "bradlc.vscode-tailwindcss",

    // Data, docs and shell: fleet.yml, SCHEMA.md, the loops' workflows
    "redhat.vscode-yaml",
    "davidanson.vscode-markdownlint",
    "yzhang.markdown-all-in-one",
    "timonwong.shellcheck",
    "foxundermoon.shell-format",
    "editorconfig.editorconfig",
    "streetsidesoftware.code-spell-checker",

    // The Jekyll fleet (Liquid templates)
    "shopify.liquid"
  ],
  "unwantedRecommendations": [
    // Replaced by ms-azuretools.vscode-containers.
    "ms-azuretools.vscode-docker",
    "ms-vscode.nodejs-extension-pack"
  ]
}
