      "presentation": { "group": "5-jekyll" }
    },
    {
      "name": "💎 Jekyll: 2005 (:4018)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bundle exec jekyll serve --host 127.0.0.1 --port 4018 --livereload --livereload-port 35738",
