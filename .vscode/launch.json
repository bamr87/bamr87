{
  // ==========================================================================
  // Launch configurations — Docker-first, fleet-aware.
  //
  // TWO WAYS a project runs, and the registry (_data/ports.yml) decides which:
  //
  //   host: compose   The project has its own docker-compose.yml. It runs as
  //                   its OWN compose project, driven by tools/fleet-dev.sh,
  //                   joined to the others by the external `fleet-net`.
  //                   (Not one merged compose file: `include:` collapses every
  //                   service into one namespace and the fleet's names collide
  //                   — `jekyll` is claimed by 5 repos, `redis` by 4.)
  //
  //   host: devenv    The project has no compose of its own, so it runs inside
  //                   the shared workspace container via `docker compose exec`.
  //
  // EVERY PORT BELOW COMES FROM _data/ports.yml. Do not invent one here — add
  // it to the registry, run `tools/fleet-compose.py sync`, and drift check (m)
  // keeps the two in agreement. Bands: 4010-4039 Jekyll, 5000-5199 frontends,
  // 8100-8149 APIs, 5700-5749 debuggers, 35730-35759 livereload.
  //
  // Groups:
  //   0-fleet       start/stop/inspect whole projects (tools/fleet-dev.sh)
  //   1-view        the Jekyll dash in a browser
  //   2-generators  dash-gen / console / lake inside devenv
  //   3-verify      dash-gen fixture tests inside devenv
  //   4-docs        MkDocs
  //   5-jekyll      the Jekyll fleet
  //   6-apps        Vite / Node frontends
  //   7-python      Django / FastAPI + REAL debugpy attach
  //   8-ext         compile in devenv, Extension Host on the host
  //   9-cli         Python / Node CLIs
  //   10-content    quick file peeks inside devenv
  //
  // Servers started inside a container bind 0.0.0.0 so the published loopback
  // mapping reaches them.
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    // ----------------------------------------------------------------- FLEET
    {
      "name": "🚀 Fleet: up (pick a project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh up ${input:fleetProject}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 1 }
    },
    {
      "name": "🐞 Fleet: up --debug (pick a project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh up ${input:fleetProject} --debug",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 2 }
    },
    {
      "name": "🏗️ Fleet: up hub (devenv + console + phoenix + shared)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh up hub",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 3 }
    },
    {
      "name": "🌍 Fleet: up --all (every checked-out project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh up --all",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 4 }
    },
    {
      "name": "📋 Fleet: ps (what is running, with URLs)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh ps --all",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 5 }
    },
    {
      "name": "🔌 Fleet: ports (the allocation table)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh ports",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 6 }
    },
    {
      "name": "🛑 Fleet: down --all",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh down --all",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 7 }
    },
    {
      "name": "📜 Fleet: logs (pick a project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/fleet-dev.sh logs ${input:fleetProject}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 8 }
    },

    // ------------------------------------------------------------------ VIEW
    {
      "name": "🛰️ Dash: Debug Site in Browser (Docker)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:${input:portNumber}",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up hub",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": { "group": "1-view" }
    },
    {
      "name": "🔗 Dash: Attach to Running Browser",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "urlFilter": "127.0.0.1:*",
      "presentation": { "group": "1-view" }
    },
    // ------------------------------------------------------------------ DOCS
    {
      "name": "📚 MkDocs: Serve (README submodule, compose :8001)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose logs -f --tail=50 mkdocs",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up hub",
      "serverReadyAction": {
        "pattern": "Serving on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:8001/",
        "action": "openExternally"
      },
      "presentation": { "group": "4-docs" }
    },
    {
      "name": "🔨 MkDocs: Build Strict (README submodule)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose run --rm mkdocs build --strict --clean",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-docs" }
    },
    {
