    },
    {
      "name": "💎 Jekyll: zer0-pages-remote (:4020)",
      "type": "node-terminal",
      "request": "launch",
      "command": "bundle exec jekyll serve --host 127.0.0.1 --port 4020 --livereload --livereload-port 35740",
      "cwd": "${workspaceFolder}/projects/zer0-pages-remote",
      "presentation": { "group": "5-jekyll" }
    },

    // ------------------------------------------------------------------ APPS
    {
      "name": "⚡ Vite: cv-builder-pro (:5000)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "127.0.0.1", "--port", "5000"],
      "cwd": "${workspaceFolder}/projects/cv-builder-pro",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "6-apps" }
    },
    {
      "name": "⚡ Vite: gitnexus (:8080)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/projects/gitnexus",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "6-apps" }
    },
    {
      "name": "⚡ Vite: gitorio app (:5174)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "127.0.0.1", "--port", "5174"],
      "cwd": "${workspaceFolder}/projects/gitorio/app",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "6-apps" }
    },
    {
      "name": "⚡ Vite: rewind-arcade (:5175)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "127.0.0.1", "--port", "5175"],
      "cwd": "${workspaceFolder}/projects/rewind-arcade/arcade",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "6-apps" }
    },
    {
      "name": "⚡ Vite: aieo frontend (:5176)",
