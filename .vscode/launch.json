{
  // ==========================================================================
  // Launch configurations for the bamr87 dash — the local control plane.
  //
  // Mirrors the stack documented in docs/HARNESS-OPS.md ("The two planes"):
  //   VIEW        the Jekyll dash in Docker on :4000 (msedge debug)
  //   MONITOR/    the dash-gen generators (debugpy) — harness inventory,
  //   ORCHESTRATE triage, actions, remediation queue, issue pipeline, …
  //   VERIFY      the dash-gen fixture tests (plain scripts, not pytest)
  //   DOCS        MkDocs, which lives in the README submodule (the hub's own
  //               mkdocs.yml was deleted; see CLAUDE.md)
  //
  // Task hooks (preLaunchTask/postDebugTask) reference .vscode/tasks.json.
  // Everything here wraps the same tools/ entrypoints CI runs — see
  // tools/dash for the CLI equivalents. The pre-2026 Django/PostHog configs
  // (foreign to this repo, and structurally broken) live in git history.
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    // ------------------------------------------------------------------ VIEW
    {
      "name": "🛰️ Dash: Debug Site in Browser (Docker)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${input:portNumber}",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Docker: Compose Up (Detached)",
      "postDebugTask": "Docker: Compose Stop",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": { "group": "1-view" }
    },
    {
      "name": "🔗 Dash: Attach to Running Browser",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "urlFilter": "localhost:*",
      "presentation": { "group": "1-view" }
    },
    {
      "name": "🔄 Dash: Rebuild Containers & Debug",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${input:portNumber}",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Docker: Rebuild (Force)",
      "postDebugTask": "Docker: Compose Down",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": { "group": "1-view" }
    },

    // --------------------------------------------- MONITOR / ORCHESTRATE
    // All generators run through the one dispatcher; auth comes from your
    // gh login (GH_TOKEN/GITHUB_TOKEN) and every generator degrades rather
    // than dies without it.
    {
      "name": "🧭 dash-gen: run a generator…",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["${input:dashGenCommand}"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: live fleet scan",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["harnesses"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: offline (reuse committed scan)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["harnesses", "--offline"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: fan-out gap targets",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["harnesses", "--gaps"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },

    // --------------------------------------------------------------- CONSOLE
    // The Harness Console — the local control plane's front end (FastAPI).
    // Debug the server in-process; the page is at http://127.0.0.1:4001/.
    {
      "name": "🎛️ Harness Console (uvicorn, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "4001", "--reload", "--reload-dir", "${workspaceFolder}/tools/console"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/tools/console",
      "env": { "PYTHONUNBUFFERED": "1" },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "presentation": { "group": "2-generators" }
    },

    // ---------------------------------------------------------------- VERIFY
    // The dash-gen fixture tests are dependency-light plain scripts
    // (python3 test_x.py), so debug the open file directly — no pytest.
    {
      "name": "🧪 dash-gen: Debug Current Fixture Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "3-verify" }
    },

    // ------------------------------------------------------------------ DOCS
    {
      "name": "📚 MkDocs: Serve (README submodule)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["serve", "--dev-addr=127.0.0.1:8000"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/projects/README",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "4-docs" }
    },
    {
      "name": "🔨 MkDocs: Build Strict (README submodule)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["build", "--strict", "--clean"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/projects/README",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "4-docs" }
    }
  ],

  "inputs": [
    {
      // The compose port map (docker-compose.yml): 4000 Jekyll dash,
      // 5000 CV Builder, 5173 Vite HMR, 8000 MkDocs.
      "id": "portNumber",
      "description": "Application port (4000 dash · 5000 CV · 5173 HMR · 8000 MkDocs)",
      "type": "pickString",
      "options": ["4000", "5000", "5173", "8000"],
      "default": "4000"
    },
    {
      // Mirrors `tools/dash gen <cmd>`. `harnesses`/`harness`/`remediate`/
      // `targets`/`estimate`/`ledger` work offline from committed _data/;
      // the rest gather live signals and want a GitHub token.
      "id": "dashGenCommand",
      "description": "dash-gen subcommand (see .github/scripts/dash-gen/README.md)",
      "type": "pickString",
      "options": [
        "harnesses",
        "harness",
        "triage",
        "actions",
        "ai-usage",
        "daily",
        "remediate",
        "issues",
        "reconcile",
        "health",
        "readme",
        "cv",
        "estimate",
        "ledger",
        "targets",
        "ai"
      ],
      "default": "harnesses"
    }
  ]
}
