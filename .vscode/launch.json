  "inputs": [
    {
      // Every project with a compose file of its own, from _data/ports.yml.
      "id": "fleetProject",
      "description": "Fleet project (tools/fleet-dev.sh list)",
      "type": "pickString",
      "options": ["hub", "law-ai", "djangoerp", "fredgar-ai", "barodybroject", "aieo", "ai-seed", "gitorio", "bashos", "it-journey", "zer0-mistakes", "bashconsultants", "zer0-pages", "zer0-pages-remote", "zer0-cms", "zer0-image-generator", "lawmode"],
      "default": "hub"
    },
    {
      // The hub's own surfaces only. Everything else has a dedicated config.
      "id": "portNumber",
      "description": "Hub port (4000 dash · 4001 console · 5000 CV · 8000 MkDocs · 6006 Phoenix)",
      "type": "pickString",
      "options": ["4000", "4001", "5000", "5173", "8000", "6006"],
      "default": "4000"
    },
    {
      "id": "dashGenCommand",
      "description": "dash-gen subcommand (see .github/scripts/dash-gen/README.md)",
      "type": "pickString",
      "options": [
        "harnesses",
        "harness",
        "triage",
        "actions",
        "ai-usage",
        "daily",
        "remediate",
        "issues",
        "reconcile",
        "health",
