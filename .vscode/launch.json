      "name": "🐍 Django: barodybroject runserver (:8010)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/projects/barodybroject/src/manage.py",
      "args": ["runserver", "127.0.0.1:8010"],
      "console": "integratedTerminal",
