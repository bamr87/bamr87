    {
      "name": "🧭 dash gen: run a generator…",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash gen ${input:dashGenCommand}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-generate", "order": 1 }
    },
    {
      "name": "🧭 dash: any subcommand…",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash ${input:dashCommand}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-generate", "order": 2 }
    },
    {
      "name": "📊 dash status (submodules, registry, drift)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash status",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-generate", "order": 3 }
    },
    {
      "name": "📊 dash monitor (refresh health, print repos needing attention)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash monitor",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-generate", "order": 4 }
    },
    {
      "name": "🛠️ Harness inventory: live fleet scan",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash harnesses",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-generate", "order": 5 }
    },
    {
      "name": "🛠️ Harness inventory: offline (reuse the committed scan)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash harnesses --offline",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-generate", "order": 6 }
    },
    {
      "name": "🛠️ Harness inventory: fan-out gap targets",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash harnesses gaps",
