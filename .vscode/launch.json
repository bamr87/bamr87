      "command": "tools/fleet-dev.sh up bashos && tools/fleet-dev.sh logs bashos langgraph-dev",
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "7-python"
      }
    },
    {
      "name": "🧪 pytest: current file (in devenv)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace devenv python3 -m pytest \"${relativeFile}\" -v",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up hub",
      "presentation": {
        "group": "7-python"
      }
    },
    // --------------------------------------------- MONITOR / ORCHESTRATE
    // All generators run through the one dispatcher inside devenv; auth
    // comes from compose env (GH_TOKEN/GITHUB_TOKEN) and every generator
    // degrades rather than dies without it.
    {
      "name": "🧭 dash-gen: run a generator…",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py ${input:dashGenCommand}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: live fleet scan",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py harnesses",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: offline (reuse committed scan)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py harnesses --offline",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: fan-out gap targets",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py harnesses --gaps",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },

    // --------------------------------------------------------------- CONSOLE
    // The Harness Console — compose service `console` on 127.0.0.1:4001.
    {
      "name": "🎛️ Harness Console (compose)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose logs -f --tail=50 console",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure console",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:4001/",
        "action": "openExternally"
      },
      "presentation": { "group": "2-generators" }
    },

    // ------------------------------------------------------------------ LAKE
    {
      "name": "🌊 Lake: sync (extract GitHub → .dash-lake/fleet.sqlite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py lake sync --days 7",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure lake stack",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🌊 Lake: status",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py lake status",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure lake stack",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🔭 Lake: export traces to Phoenix (dry run, incl. local sessions)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py lake export --local --dry-run",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure lake stack",
      "presentation": { "group": "2-generators" }
    },
    // ---------------------------------------------------------------- VERIFY
    {
      "name": "🧪 dash-gen: Debug Current Fixture Test",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace devenv python3 \"${relativeFile}\"",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "3-verify" }
    },
    // ----------------------------------------------------------- EXTENSIONS
    // Compile inside devenv (container-first); Extension Host still runs on
    // the host because it is VS Code itself.
    {
      "name": "🧩 Ext: csv-vscoode",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/projects/csv-vscoode"],
      "outFiles": ["${workspaceFolder}/projects/csv-vscoode/out/**/*.js"],
      "preLaunchTask": "devenv: compile csv-vscoode",
      "presentation": { "group": "8-ext" }
    },
    {
      "name": "🧩 Ext: vs-sonic-pi",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/projects/vs-sonic-pi"],
      "outFiles": ["${workspaceFolder}/projects/vs-sonic-pi/dist/**/*.js"],
      "preLaunchTask": "devenv: compile vs-sonic-pi",
      "presentation": { "group": "8-ext" }
    },
    {
      "name": "🧩 Ext: zpl-viewer",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/projects/zpl-viewer"],
      "outFiles": ["${workspaceFolder}/projects/zpl-viewer/dist/**/*.js"],
      "preLaunchTask": "devenv: compile zpl-viewer",
      "presentation": { "group": "8-ext" }
    },
    {
      "name": "🧩 Ext: zer0-cms",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/projects/zer0-cms"],
      "outFiles": ["${workspaceFolder}/projects/zer0-cms/dist/**/*.js"],
      "preLaunchTask": "devenv: compile zer0-cms",
      "presentation": { "group": "8-ext" }
    },
    // ------------------------------------------------------------------- CLI
    {
      "name": "⌨️ CLI: bashos --help",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/bashos -e PYTHONPATH=/workspace/projects/bashos/src devenv python3 -m bashos.shell.cli --help",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "9-cli" }
    },
    {
      "name": "⌨️ CLI: ocrmd --help",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/ocrmd devenv python3 -m ocrmd.cli --help",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "9-cli" }
    },
    {
      "name": "⌨️ CLI: lawmode --help",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/lawmode devenv python3 -m lawmode.cli --help",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "9-cli" }
    },
    {
