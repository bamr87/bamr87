{
  // ==========================================================================
  // Launch configurations — every surface of the harness, from F5.
  //
  // ONE FRONT DOOR. Every entry goes through `tools/dash` (the command router,
  // docs/DASH.md) or the console's own entry points, never through a second
  // implementation: what F5 runs is what the CLI, the Harness Console's job
  // API and CI run. Where a hub tool is best debugged natively (the console's
  // FastAPI, a generator test), the entry is a real `debugpy` launch against
  // `.venv-console` — the venv tools/console/run.sh owns — so breakpoints work.
  //
  // TWO PLANES, and which one an entry talks to:
  //
  //   the shared core   `tools/dash up`: compose project `fleet` from
  //                     docker-compose.yml — devenv (the workspace), console
  //                     (:4001), db, redis; phoenix / docs / elk / mcp behind
  //                     profiles (docs/CONTAINERS.md). The workspace-hosted
  //                     projects below (no compose file of their own) run
  //                     INSIDE devenv on its workspace block: Jekyll 4040-4049
  //                     (+ livereload 35760-35769), Vite 5000-5001, MkDocs 8000.
  //   per-project       `tools/dash dev up <project> [--debug]`: the submodule's
  //   stacks            own docker-compose.yml as its OWN compose project on
  //                     `fleet-net`, ports from _data/ports.yml via the
  //                     committed compose/overrides/ (docs/FLEET-COMPOSE.md;
  //                     drift check (m) gates the map). `--debug` layers the
  //                     repo's debugpy compose for the attach entries.
  //
  // PORTS ARE NEVER INVENTED HERE. Compose-hosted ports come from
  // _data/ports.yml; workspace ports from _data/fleet.yml `containers.ports.
  // workspace*` (what devenv publishes); hub ports from docker-compose.yml.
  // The /docker/ page (tools/dash docker view) joins this file to the port
  // registry by the `:NNNN` in each entry's name, so keep the port in the name.
  //
  // Groups (the console's own sections, in its order):
  //   0-fleet      the container plane: core, projects, ps, ports, smoke, down
  //   1-console    the Harness Console: native debug, page dev server, compose, TUI, MCP
  //   2-site       the public site (the console built static) + Playwright verify
  //   3-observe    the lake, the log/metrics planes, the code index, the content atlas
  //   4-generate   dash-gen and the registries (the console's observe/plan operations)
  //   5-loops      the local loop runner (JEV), scout, evolution, workflow scaffolding
  //   6-verify     the gates and tests, natively (debuggable) and in devenv
  //   7-projects   compose-hosted submodules + real debugpy attach
  //   8-workspace  devenv-hosted submodules (Jekyll, Vite, MkDocs) and a devenv shell
  //   9-ext        VS Code extensions: compile in devenv, Extension Host on the host
  //   10-cli       submodule CLIs and test suites in devenv
  //
  // Servers started inside a container bind 0.0.0.0 so the published loopback
  // mapping reaches them; everything is published on 127.0.0.1 only.
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    // ----------------------------------------------------------------- FLEET
    {
      "name": "🏗️ Fleet: up core (devenv, console, db, redis)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash up",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 1 }
    },
    {
      "name": "🏗️ Fleet: up core + a profile (traces, docs, admin, mcp, elk, metrics)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash up --profile ${input:hubProfile}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 2 }
    },
    {
      "name": "🚀 Fleet: dev up (pick a project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev up ${input:fleetProject}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 3 }
    },
    {
      "name": "🐞 Fleet: dev up --debug (pick a project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev up ${input:fleetProject} --debug",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 4 }
    },
    {
      "name": "🌍 Fleet: dev up several projects…",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev up ${input:fleetProjects}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 5 }
    },
    {
      "name": "📋 Fleet: ps (fleet-wide, who is on the network)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash ps",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 6 }
    },
    {
      "name": "📋 Fleet: dev ps --all (per project, with URLs)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev ps --all",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 7 }
    },
    {
      "name": "🔌 Fleet: dev ports (the allocation table)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev ports",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 8 }
    },
    {
      "name": "📜 Fleet: dev logs (pick a project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev logs ${input:fleetProject}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 9 }
    },
    {
      "name": "🧪 Fleet: smoke check (every running container vs _data/smoke.yml)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev smoke check",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 10 }
    },
    {
      "name": "🧪 Fleet: smoke record (rewrite the baseline)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev smoke record",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 11 }
    },
    {
      "name": "🐳 Fleet: docker view --write (the /docker/ page → _data/docker.yml)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash docker view --write",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 12 }
    },
    {
      "name": "🩺 Fleet: doctor (environment checks, dry run)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash doctor",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 13 }
    },
    {
      "name": "🛑 Fleet: dev down (pick a project)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash dev down ${input:fleetProject}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 14 }
    },
    {
      "name": "🛑 Fleet: down core (and every project with --all)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash down ${input:downScope}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "0-fleet", "order": 15 }
    },

    // --------------------------------------------------------------- CONSOLE
    // The Harness Console (tools/console/README.md): the write-capable front
    // end, every allowlisted `dash` operation as a job. Three ways to run it:
    //   native debug  uvicorn under debugpy on :4004 (so it never fights the
    //                 compose console on :4001); breakpoints in app.py/core.py
    //   compose       `tools/dash console --docker` — the long-lived service
    //   native        `CONSOLE_RELOAD=1 tools/dash console` on :4001
    // The page is a Vite app (tools/console/web); its dev server on :5173
    // proxies /api to whichever console the task names.
    {
      "name": "🎛️ Console: API — debug natively (debugpy, uvicorn :4004)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "4004"],
      "cwd": "${workspaceFolder}/tools/console",
      "python": "${workspaceFolder}/.venv-console/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "CONSOLE_PORT": "4004",
        // The page's dev server origin, so the Terminal page's WebSocket is admitted.
        "DASH_CONSOLE_ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "preLaunchTask": "Console: bootstrap venv",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:4004/",
        "action": "openExternally"
      },
      "presentation": { "group": "1-console", "order": 1 }
    },
    {
      "name": "🎛️ Console: page in Edge (:5173 → debug API :4004)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5173/",
      "webRoot": "${workspaceFolder}/tools/console/web",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Console: web dev server (→ debug API :4004)",
      "presentation": { "group": "1-console", "order": 2 }
    },
    {
      "name": "🎛️ Console: page in Edge (:5173 → compose console :4001)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5173/",
      "webRoot": "${workspaceFolder}/tools/console/web",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "Console: web dev server (→ compose console :4001)",
      "presentation": { "group": "1-console", "order": 3 }
    },
    {
      "name": "🎛️ Console: compose service (:4001, follow logs)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash console --docker && docker compose logs -f --tail=50 console",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "console: (http://\\S+)",
        "uriFormat": "http://127.0.0.1:4001/",
        "action": "openExternally"
      },
      "presentation": { "group": "1-console", "order": 4 }
    },
    {
      "name": "🎛️ Console: native with auto-reload (:4001; stop the compose console first)",
      "type": "node-terminal",
      "request": "launch",
      "command": "CONSOLE_RELOAD=1 DASH_CONSOLE_ALLOWED_ORIGINS=http://localhost:5173 tools/dash console",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:4001/",
        "action": "openExternally"
      },
      "presentation": { "group": "1-console", "order": 5 }
    },
    {
      "name": "🎛️ Console: open in Edge (debug the built page, pick a hub port)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:${input:portNumber}/",
      "webRoot": "${workspaceFolder}/tools/console/web",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "1-console", "order": 6 }
    },
    {
      "name": "🔗 Console: attach to a running Edge (9222)",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/tools/console/web",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "urlFilter": "127.0.0.1:*",
      "presentation": { "group": "1-console", "order": 7 }
    },
    {
      "name": "🖥️ TUI: terminal dash (native, .venv-tui)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash tui",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "1-console", "order": 8 }
    },
    {
      "name": "🖥️ TUI: terminal dash in Docker (joins the compose console)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash tui --docker",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "1-console", "order": 9 }
    },
    {
      "name": "🔌 MCP: list the fleet server's tools",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash mcp --list-tools",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "1-console", "order": 10 }
    },
    {
      "name": "🔌 MCP: streamable HTTP server (:4002; stop the compose `mcp` first)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash mcp --http",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "1-console", "order": 11 }
    },
    {
      "name": "🔌 MCP: compose service + tunnel URL",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash up --profile mcp --profile mcp-tunnel && tools/dash mcp --tunnel-url",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "1-console", "order": 12 }
    },
    {
      "name": "🔌 MCP: live smoke test against the running console",
      "type": "node-terminal",
      "request": "launch",
      "command": ".venv-console/bin/python tools/console/smoke_mcp_layer.py",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Console: bootstrap venv",
      "presentation": { "group": "1-console", "order": 13 }
    },

    // ------------------------------------------------------------------ SITE
    // The public site is the console's page built static (docs/CONSOLE-PAGES.md).
    {
      "name": "🌐 Site: build + serve the public snapshot (:4000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash serve",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "dash serve: (http://\\S+)",
        "uriFormat": "http://127.0.0.1:4000/",
        "action": "openExternally"
      },
      "presentation": { "group": "2-site", "order": 1 }
    },
    {
      "name": "🌐 Site: debug in Edge (:4000)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:4000/",
      "webRoot": "${workspaceFolder}/tools/console/web",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "presentation": { "group": "2-site", "order": 2 }
    },
    {
      "name": "🏗️ Site: build exactly as CI (build-pages.sh + machine API → _site)",
      "type": "node-terminal",
      "request": "launch",
      "command": "CONSOLE_BASE=/ OUT=_site tools/console/build-pages.sh && tools/dash-gen machine-api --out _site && echo 'built: _site/'",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "2-site", "order": 3 }
    },
    {
      "name": "🧪 Verify: every user scenario (Playwright → test/evidence/)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash verify",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Verify: install Playwright",
      "presentation": { "group": "2-site", "order": 4 }
    },
    {
      "name": "🧪 Verify: one scenario, headed (pick)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash verify --only ${input:verifyScenario} --headed",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Verify: install Playwright",
      "presentation": { "group": "2-site", "order": 5 }
    },
    {
      "name": "🧪 Verify: list scenarios and the features they prove",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash verify --list",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Verify: install Playwright",
      "presentation": { "group": "2-site", "order": 6 }
    },

    // --------------------------------------------------------------- OBSERVE
    // The local stack's data: the lake (.dash-lake/fleet.sqlite), Phoenix
    // traces, the ELK/Grafana planes, the Qdrant code index, the content atlas
    // (docs/HARNESS-OPS.md, docs/OBSERVABILITY.md, docs/CONTENT-ATLAS.md).
    {
      "name": "🌊 Lake: sync (GitHub → the lake, pick a window)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash lake sync --days ${input:lakeDays}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 1 }
    },
    {
      "name": "🌊 Lake: sessions (this machine's Claude Code transcripts)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash lake sessions",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 2 }
    },
    {
      "name": "🌊 Lake: review (both planes, offline)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash lake review --days ${input:lakeDays}",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 3 }
    },
    {
      "name": "🌊 Lake: status",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash lake status",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 4 }
    },
    {
      "name": "🔭 Lake: export traces to Phoenix (:6006; dry run, incl. local sessions)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash lake export --local --dry-run",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core + traces",
      "presentation": { "group": "3-observe", "order": 5 }
    },
    {
      "name": "🔭 Lake: export traces to Phoenix (:6006; ship)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash lake export --local && echo 'phoenix: http://127.0.0.1:6006/projects'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core + traces",
      "serverReadyAction": {
        "pattern": "phoenix: (http://\\S+)",
        "uriFormat": "http://127.0.0.1:6006/projects",
        "action": "openExternally"
      },
      "presentation": { "group": "3-observe", "order": 6 }
    },
    {
      "name": "🔭 Observe: status (every plane, sizes vs budget)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash observe status",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 7 }
    },
    {
      "name": "🔭 Observe: up (ELK + Grafana + Qdrant + OTel + Prometheus) and open the Observe tab",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash observe up && tools/dash observe open",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 8 }
    },
    {
      "name": "🔭 Observe: ship the lake's Actions logs (ECS → Logstash)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash observe ship",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 9 }
    },
    {
      "name": "🔭 Observe: Claude Code OTel status (this machine)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash observe claude status",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 10 }
    },
    {
      "name": "🔭 Observe: down (keeps the data)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash observe down",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 11 }
    },
    {
      "name": "🔎 Index: status + coverage (the Qdrant code index)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash index status && tools/dash index coverage",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 12 }
    },
    {
      "name": "🔎 Index: semantic search…",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash index search \"${input:indexQuery}\"",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 13 }
    },
    {
      "name": "📰 Content: report (the atlas)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash content report",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "3-observe", "order": 14 }
    },
    {
      "name": "📰 Content: sync one site into the lake (pick)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash content sync --site ${input:contentSite}",
