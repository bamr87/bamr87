      "command": "docker compose exec -w /workspace/projects/gitorio/packages/gitnexus devenv sh -c '[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund; exec npm run dev'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "http://127.0.0.1:8080/",
        "action": "openExternally"
      },
      "presentation": { "group": "8-workspace", "order": 9 }
    },
    {
      "name": "📚 MkDocs: projects/README in devenv (:8000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -w /workspace/projects/README devenv mkdocs serve --dev-addr 0.0.0.0:8000",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "serverReadyAction": {
        "pattern": "Serving on (https?://\\S+)",
        "uriFormat": "http://127.0.0.1:8000/",
        "action": "openExternally"
      },
      "presentation": { "group": "8-workspace", "order": 10 }
    },
    {
      "name": "📚 MkDocs: compose service (:8001, docs profile)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash up --profile docs && docker compose --profile docs logs -f --tail=50 mkdocs",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Serving on (https?://\\S+)",
        "uriFormat": "http://127.0.0.1:8001/",
        "action": "openExternally"
      },
      "presentation": { "group": "8-workspace", "order": 11 }
    },
    {
      "name": "🔨 MkDocs: build --strict (projects/README, devenv)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/README devenv mkdocs build --strict --clean",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "8-workspace", "order": 12 }
    },
    {
      "name": "🐚 devenv: shell in the workspace container",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec devenv bash",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "8-workspace", "order": 13 }
    },
    {
      "name": "⌨️ devenv: run a command in a submodule… (pick, then type)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -w /workspace/projects/${input:submodule} devenv ${input:devenvCommand}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "8-workspace", "order": 14 }
    },

    // ----------------------------------------------------------- EXTENSIONS
    // Compile inside devenv (container-first); the Extension Host still runs
    // on the host because it is VS Code itself.
    {
      "name": "🧩 Ext: vs-sonic-pi",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/projects/vs-sonic-pi"],
      "outFiles": ["${workspaceFolder}/projects/vs-sonic-pi/dist/**/*.js"],
      "preLaunchTask": "devenv: compile vs-sonic-pi",
      "presentation": { "group": "9-ext", "order": 1 }
    },
    {
      "name": "🧩 Ext: zpl-viewer",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/projects/zpl-viewer"],
      "outFiles": ["${workspaceFolder}/projects/zpl-viewer/dist/**/*.js"],
      "preLaunchTask": "devenv: compile zpl-viewer",
      "presentation": { "group": "9-ext", "order": 2 }
    },
    {
      "name": "🧩 Ext: zer0-cms",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/projects/zer0-cms"],
      "outFiles": ["${workspaceFolder}/projects/zer0-cms/dist/**/*.js"],
      "preLaunchTask": "devenv: compile zer0-cms",
      "presentation": { "group": "9-ext", "order": 3 }
    },

    // ------------------------------------------------------------------- CLI
    {
      "name": "⌨️ CLI: bashos --help",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/bashos -e PYTHONPATH=/workspace/projects/bashos/src devenv python3 -m bashos.shell.cli --help",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 1 }
    },
    {
      "name": "⌨️ CLI: ocrmd --help",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/ocrmd devenv python3 -m ocrmd.cli --help",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 2 }
    },
    {
      "name": "⌨️ CLI: wtd --help (gitorio/packages/wtd)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/gitorio/packages/wtd devenv python3 -m wtd.cli --help",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 3 }
    },
    {
      "name": "⌨️ CLI: gwtp --help (gitorio/packages/git-with-the-program)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/gitorio/packages/git-with-the-program devenv sh -c '[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund; npx tsx src/cli/index.ts --help'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 4 }
    },
    {
      "name": "🧪 Node test: bashcrawl",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/bashcrawl devenv sh -c '[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund; npm test'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 5 }
    },
    {
      "name": "🧪 pytest: githubai",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/githubai devenv python3 -m pytest -q",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 6 }
    },
    {
      "name": "🧪 pytest: a submodule… (pick)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/${input:submodule} devenv python3 -m pytest -q",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 7 }
    },
    {
      "name": "🧪 npm script: a submodule… (pick, then name the script)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/${input:submodule} devenv sh -c '[ -d node_modules/.bin ] || npm install --no-package-lock --no-audit --no-fund; npm run ${input:npmScript}'",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 8 }
    },
    {
      "name": "📝 scripts: current file (devenv python3)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/scripts devenv python3 \"/workspace/${relativeFile}\"",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 9 }
    },
    {
      "name": "📝 skills: show Agents.md",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv head -n 80 /workspace/projects/skills/Agents.md",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up core",
      "presentation": { "group": "10-cli", "order": 10 }
    }
  ],

  "compounds": [
    {
      // The console end to end with breakpoints on both sides: uvicorn under
      // debugpy on :4004 and the page's dev server on :5173 proxied to it,
      // opened in Edge with source maps.
      "name": "🎛️ Console: full stack (API debug :4004 + page :5173)",
      "configurations": [
        "🎛️ Console: API — debug natively (debugpy, uvicorn :4004)",
        "🎛️ Console: page in Edge (:5173 → debug API :4004)"
      ],
      "stopAll": true,
      "presentation": { "group": "1-console", "order": 0 }
    }
  ],

  "inputs": [
    {
      // Every compose-hosted project in _data/ports.yml (`tools/dash dev list`).
      "id": "fleetProject",
      "description": "Fleet project (tools/dash dev list)",
      "type": "pickString",
      "options": ["it-journey", "zer0-cms", "gitorio", "law-ai", "djangoerp", "fredgar-ai", "bashos"],
      "default": "it-journey"
    },
    {
      // Several at once; `--all` is avoided because it also starts the
      // `fleet-hub` pseudo-project, which collides with the running core.
      "id": "fleetProjects",
      "description": "Projects to dev up, space-separated",
      "type": "promptString",
      "default": "it-journey zer0-cms"
    },
    {
      "id": "downScope",
      "description": "tools/dash down: the core only, or every project too",
      "type": "pickString",
      "options": ["core", "--all"],
      "default": "core"
    },
    {
      // docker-compose.yml profiles beyond the always-on core.
      "id": "hubProfile",
      "description": "Hub profile (traces = Phoenix :6006 · docs = MkDocs :8001 + wiki :3000 · admin = pgAdmin :5050 · mcp = MCP :4002 · elk / metrics = the log and metrics planes)",
      "type": "pickString",
      "options": ["traces", "docs", "admin", "mcp", "elk", "metrics"],
      "default": "traces"
    },
    {
      // The hub's own surfaces. Everything else has a dedicated entry.
      "id": "portNumber",
      "description": "Hub port (4000 site · 4001 console · 4004 console debug · 5173 page dev · 4002 MCP · 6006 Phoenix · 5601 Kibana · 3001 Grafana · 8000/8001 MkDocs)",
      "type": "pickString",
      "options": ["4001", "4000", "4004", "5173", "6006", "5601", "3001", "9090", "8000", "8001", "3000", "5050"],
      "default": "4001"
    },
    {
      // dash-gen subcommands with their usual flags (.github/scripts/dash-gen/README.md).
      // Those marked (token) need GitHub auth; the rest run offline.
      "id": "dashGenCommand",
      "description": "dash gen subcommand (tools/dash-gen --help)",
      "type": "pickString",
      "options": [
        "harnesses --offline",
        "harnesses",
        "harnesses --gaps",
        "harness",
        "health",
        "readme",
        "readme --check",
        "cv",
        "triage",
        "actions --days 30",
        "ai-usage --days 30",
        "daily --days 1",
        "remediate",
        "issues",
        "reconcile",
        "targets --no-dedupe",
        "scout",
        "estimate",
        "ledger",
        "vendor",
        "workflows list",
        "workflows lint",
        "compose --check",
        "machine-api --out _site",
        "all"
      ],
      "default": "harnesses --offline"
    },
    {
      "id": "dashCommand",
      "description": "tools/dash <subcommand and args> (tools/dash help)",
      "type": "promptString",
      "default": "help"
    },
    {
      "id": "configKey",
      "description": "fleet.yml dotted key (empty = the whole contract)",
      "type": "promptString",
      "default": "containers"
    },
    {
      // Window for the lake-backed readers and the analytics generators.
      "id": "lakeDays",
      "description": "Window in days",
      "type": "pickString",
      "options": ["7", "14", "30", "90"],
      "default": "7"
    },
    {
      // Loops with a local: block (tools/dash loop list).
      "id": "loopId",
      "description": "Loop id (tools/dash loop list)",
      "type": "promptString",
      "default": "repo-scout/scout"
    },
    {
      // _data/fleet.yml `content.sites`.
      "id": "contentSite",
      "description": "Content site (fleet.yml content.sites)",
      "type": "pickString",
      "options": ["lifehacker.dev", "it-journey", "bash-365.com", "year-of-ai.github.io", "ai-world-view.github.io", "irony-works", "wargames", "2005", "china"],
      "default": "it-journey"
    },
    {
      // verify/scenarios/*.yml (tools/dash verify --list).
      "id": "verifyScenario",
      "description": "Scenario id (verify/scenarios/)",
      "type": "pickString",
      "options": ["home", "dashboard", "connect", "engagements", "features", "harnesses", "monitor", "roadmap", "triage", "work", "workflows", "loop-run"],
      "default": "home"
    },
    {
      "id": "indexQuery",
      "description": "Semantic search over the code index",
      "type": "promptString",
      "default": "how are ports allocated"
    },
    {
      "id": "workflowKind",
      "description": "Workflow kind to scaffold (dry run; add --write by hand)",
      "type": "pickString",
      "options": ["loop", "agent-loop", "gate", "reusable", "dispatch"],
      "default": "gate"
    },
    {
      "id": "workflowId",
      "description": "Workflow id (kebab-case file stem)",
      "type": "promptString",
      "default": "my-check"
    },
    {
      "id": "evidenceRepo",
      "description": "Repo (owner/name or registry name)",
      "type": "promptString",
      "default": "bamr87/bamr87"
    },
    {
      "id": "evidenceIssue",
      "description": "Issue number",
      "type": "promptString",
      "default": "1"
    },
    {
      // `python3 file.py Class.method` — the unittest runner inside each test file.
      "id": "unittestCase",
      "description": "Test case as Class.test_method, for the open file",
      "type": "promptString",
      "default": "MachineApiTests.test_degraded_without_inputs"
    },
    {
      // The hub gate's individual checks (AGENTS.md "Stack & commands").
      "id": "gateCommand",
      "description": "Gate / check to run",
      "type": "pickString",
      "options": [
        "tools/check-drift.sh --report",
        "tools/check-drift.sh",
        "tools/check-drift.sh --remote",
        "python3 tools/schema_lint.py check .",
        "python3 tools/schema_lint.py check . --fix",
        "python3 tools/docs_index.py --check",
        "python3 tools/unwrap-prose.py --check ${relativeFile}",
        "python3 tools/gen-specs-data.py --check",
        "python3 tools/gen-catalog.py --check",
        "python3 -m tools.jev generated guard --base origin/main",
        "python3 tools/governance_lint.py check .",
        "tools/dash workflows lint --strict",
        "tools/dash-gen compose --check",
        "tools/dash features check .",
        "shellcheck tools/*.sh tools/observability/*.sh",
        "actionlint .github/workflows/*.yml",
        "python3 tools/console/test_pages.py"
      ],
      "default": "tools/check-drift.sh --report"
    },
    {
      // Every checked-out submodule directory (.gitmodules).
      "id": "submodule",
      "description": "Submodule directory under projects/",
      "type": "pickString",
      "options": [
        "README", "ai-world-view.github.io", "bamr87.github.io", "bash-365-apex", "bash-365.com",
        "bashcrawl", "bashos", "cv-pro", "djangoerp", "edgar-pipeline", "fleet-infra", "fleet-mobile",
        "fleet-observe", "fredgar-ai", "githubai", "gitorio", "godotgo", "it-journey", "kvlite",
        "law-ai", "lifehacker.dev", "netprobe", "ocrmd", "outbox", "ragio-ai", "rewind-arcade",
        "schema-lang", "scripts", "sec-lab", "sensor-mesh", "skills", "vs-sonic-pi",
        "year-of-ai.github.io", "zer0-cms", "zer0-id", "zer0-kernel", "zer0-mistakes", "zpl-viewer"
      ],
      "default": "scripts"
    },
    {
      "id": "devenvCommand",
      "description": "Command to run in that directory inside devenv",
      "type": "promptString",
      "default": "bash"
    },
    {
      "id": "npmScript",
      "description": "npm script name (package.json scripts)",
      "type": "promptString",
      "default": "test"
    }
  ]
}
