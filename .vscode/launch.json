    {
      // The compose port map (docker-compose.yml): 4000 Jekyll dash,
      // 5000 CV Builder, 5173 Vite HMR, 8000 MkDocs.
      "id": "portNumber",
      "description": "Application port (4000 dash · 5000 CV · 5173 HMR · 8000 MkDocs)",
      "type": "pickString",
      "options": ["4000", "5000", "5173", "8000"],
      "default": "4000"
    },
    {
      // Mirrors `tools/dash gen <cmd>`. `harnesses`/`harness`/`remediate`/
      // `targets`/`estimate`/`ledger` work offline from committed _data/;
      // the rest gather live signals and want a GitHub token.
      "id": "dashGenCommand",
      "description": "dash-gen subcommand (see .github/scripts/dash-gen/README.md)",
      "type": "pickString",
      "options": [
        "harnesses",
        "harness",
        "triage",
        "actions",
        "ai-usage",
        "daily",
        "remediate",
        "issues",
        "reconcile",
        "health",
        "readme",
        "cv",
        "estimate",
        "ledger",
        "targets",
        "ai"
      ],
      "default": "harnesses"
    }
  ]
