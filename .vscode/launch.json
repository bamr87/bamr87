      "command": "bundle exec jekyll serve --host 127.0.0.1 --port 4010 --livereload --livereload-port 35730",
      "cwd": "${workspaceFolder}/projects/it-journey",
      "presentation": { "group": "5-jekyll" }
    },
    {
      "name": "💎 Jekyll: zer0-mistakes (:4011)",
