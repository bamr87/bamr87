{
  // ==========================================================================
  // Launch configurations — Docker-first. Nothing here installs or runs on
  // the host except Extension Host (VS Code itself) and the Edge debugger
  // attaching to a container-published port.
  //
  // Every command is `docker compose exec` / `up` against docker-compose.yml:
  //   devenv   workspace (repo at /workspace) — generators, jekyll, vite, django, clis
  //   console  Harness Console :4001
  //   mkdocs   README submodule site (host :8001 → container :8000)
  //   phoenix  traces UI :6006
  //
  // Groups:
  //   1-view        Jekyll dash in Docker on :4000 (msedge)
  //   2-generators  dash-gen / console / lake inside devenv|console|phoenix
  //   3-verify      dash-gen fixture tests inside devenv
  //   4-docs        MkDocs containers
  //   5-jekyll      submodule Jekyll via devenv (:4010–4020)
  //   6-apps        Vite / Node via devenv
  //   7-python      Django / FastAPI / pytest via devenv
  //   8-ext         compile in devenv, then Extension Host on the host
  //   9-cli         Python / Node CLIs via devenv (--help)
  //   10-content    cat/head inside devenv (no host `code` open)
  //
  // Bind 0.0.0.0 inside the container so published loopback ports work.
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    // ------------------------------------------------------------------ VIEW
    {
      "name": "🛰️ Dash: Debug Site in Browser (Docker)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${input:portNumber}",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Docker: Compose Up (Detached)",
      "postDebugTask": "Docker: Compose Stop",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": { "group": "1-view" }
    },
    {
      "name": "🔗 Dash: Attach to Running Browser",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "urlFilter": "localhost:*",
      "presentation": { "group": "1-view" }
    },
    {
      "name": "🔄 Dash: Rebuild Containers & Debug",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${input:portNumber}",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Docker: Rebuild (Force)",
      "postDebugTask": "Docker: Compose Down",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": { "group": "1-view" }
    },

    // --------------------------------------------- MONITOR / ORCHESTRATE
    // All generators run through the one dispatcher inside devenv; auth
    // comes from compose env (GH_TOKEN/GITHUB_TOKEN) and every generator
    // degrades rather than dies without it.
    {
      "name": "🧭 dash-gen: run a generator…",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py ${input:dashGenCommand}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: live fleet scan",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py harnesses",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: offline (reuse committed scan)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py harnesses --offline",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: fan-out gap targets",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py harnesses --gaps",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "2-generators" }
    },

    // --------------------------------------------------------------- CONSOLE
    // The Harness Console — compose service `console` on 127.0.0.1:4001.
    {
      "name": "🎛️ Harness Console (compose)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose logs -f --tail=50 console",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure console",
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:4001/",
        "action": "openExternally"
      },
      "presentation": { "group": "2-generators" }
    },

    // ------------------------------------------------------------------ LAKE
    {
      "name": "🌊 Lake: sync (extract GitHub → .dash-lake/fleet.sqlite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py lake sync --days 7",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure lake stack",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🌊 Lake: status",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py lake status",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure lake stack",
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🔭 Lake: export traces to Phoenix (dry run, incl. local sessions)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T devenv python3 .github/scripts/dash-gen/dash_gen.py lake export --local --dry-run",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure lake stack",
      "presentation": { "group": "2-generators" }
    },

    // ---------------------------------------------------------------- VERIFY
    {
      "name": "🧪 dash-gen: Debug Current Fixture Test",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace devenv python3 \"${relativeFile}\"",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "presentation": { "group": "3-verify" }
    },

    // ------------------------------------------------------------------ DOCS
    {
      "name": "📚 MkDocs: Serve (README submodule, compose :8001)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose logs -f --tail=50 mkdocs",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure mkdocs",
      "serverReadyAction": {
        "pattern": "Serving on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:8001/",
        "action": "openExternally"
      },
      "presentation": { "group": "4-docs" }
    },
    {
      "name": "🔨 MkDocs: Build Strict (README submodule)",
      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose run --rm mkdocs build --strict --clean",
      "cwd": "${workspaceFolder}",
      "presentation": { "group": "4-docs" }
    },
    {
      "name": "📚 MkDocs: Serve (ai-seed, devenv :8003)",
      "type": "node-terminal",
      "request": "launch",
      "command": "tools/dash up ai-seed    # its own compose project on the fleet network — http://127.0.0.1:3014",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Docker: Ensure devenv",
      "serverReadyAction": {
        "pattern": "Serving on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:8003/",
        "action": "openExternally"
      },
      "presentation": { "group": "4-docs", "order": 20 }
    },

