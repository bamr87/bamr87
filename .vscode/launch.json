      "type": "node-terminal",
      "request": "launch",
      "command": "docker compose exec -T -w /workspace/projects/ai-seed devenv mkdocs serve --dev-addr=0.0.0.0:8003",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Fleet: up hub",
      "serverReadyAction": {
        "pattern": "Serving on (https?://[^\\s]+)",
        "uriFormat": "http://127.0.0.1:8003/",
        "action": "openExternally"
      },
      "presentation": { "group": "4-docs", "order": 20 }
    },

