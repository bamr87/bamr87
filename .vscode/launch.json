{
  // ==========================================================================
  // Launch configurations for the bamr87 dash — the local control plane
  // plus one debug entry per Git submodule under projects/ (registry:
  // _data/projects.yml, paths from .gitmodules).
  //
  // Groups in the Run and Debug dropdown:
  //   1-view        Jekyll dash in Docker on :4000 (msedge)
  //   2-generators  dash-gen, Harness Console :4001, lake → Phoenix :6006
  //   3-verify      dash-gen fixture tests (plain scripts, not pytest)
  //   4-docs        MkDocs in the README submodule
  //   5-jekyll      submodule Jekyll sites (unique ports 4010–4020)
  //   6-apps        Vite / Node web apps (unique ports; gitnexus keeps 8080)
  //   7-python      Django / FastAPI / pytest
  //   8-ext         VS Code extensions (extensionHost)
  //   9-cli         Python / Node CLIs (safe default: --help)
  //   10-content    markdown / scripts / consumed skills (no long-lived server)
  //
  // Submodule ports are offset from the hub map (4000 dash · 4001 console ·
  // 5000 CV Builder · 5173 Vite HMR · 8000 MkDocs) so two F5s don't collide.
  // Task hooks reference .vscode/tasks.json. Hub entries wrap tools/ the same
  // way CI does. The pre-2026 Django/PostHog configs live in git history.
  // ==========================================================================
  "version": "0.2.0",
  "configurations": [
    // ------------------------------------------------------------------ VIEW
    {
      "name": "🛰️ Dash: Debug Site in Browser (Docker)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${input:portNumber}",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Docker: Compose Up (Detached)",
      "postDebugTask": "Docker: Compose Stop",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": { "group": "1-view" }
    },
    {
      "name": "🔗 Dash: Attach to Running Browser",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "urlFilter": "localhost:*",
      "presentation": { "group": "1-view" }
    },
    {
      "name": "🔄 Dash: Rebuild Containers & Debug",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:${input:portNumber}",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Docker: Rebuild (Force)",
      "postDebugTask": "Docker: Compose Down",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "sourceMaps": true,
      "smartStep": true,
      "internalConsoleOptions": "openOnSessionStart",
      "presentation": { "group": "1-view" }
    },

    // --------------------------------------------- MONITOR / ORCHESTRATE
    // All generators run through the one dispatcher; auth comes from your
    // gh login (GH_TOKEN/GITHUB_TOKEN) and every generator degrades rather
    // than dies without it.
    {
      "name": "🧭 dash-gen: run a generator…",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["${input:dashGenCommand}"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: live fleet scan",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["harnesses"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: offline (reuse committed scan)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["harnesses", "--offline"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🛠️ Harness Inventory: fan-out gap targets",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["harnesses", "--gaps"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },

    // --------------------------------------------------------------- CONSOLE
    // The Harness Console — the local control plane's front end (FastAPI).
    // Debug the server in-process; the page is at http://127.0.0.1:4001/.
    {
      "name": "🎛️ Harness Console (uvicorn, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "127.0.0.1", "--port", "4001", "--reload", "--reload-dir", "${workspaceFolder}/tools/console"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/tools/console",
      "env": { "PYTHONUNBUFFERED": "1" },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://[^\\s]+)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "presentation": { "group": "2-generators" }
    },

    // ------------------------------------------------------------------ LAKE
    // The local data lake + Phoenix traces (docs/HARNESS-OPS.md, "The local
    // stack"). `lake` takes a sub-subcommand, so it gets its own entries
    // rather than a slot in the dashGenCommand picker. Sync needs gh auth;
    // export needs `docker compose up -d phoenix` unless --dry-run.
    {
      "name": "🌊 Lake: sync (extract GitHub → .dash-lake/fleet.sqlite)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["lake", "sync", "--days", "7"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🌊 Lake: status",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["lake", "status"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },
    {
      "name": "🔭 Lake: export traces to Phoenix (dry run, incl. local sessions)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/dash-gen/dash_gen.py",
      "args": ["lake", "export", "--local", "--dry-run"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "2-generators" }
    },

    // ---------------------------------------------------------------- VERIFY
    // The dash-gen fixture tests are dependency-light plain scripts
    // (python3 test_x.py), so debug the open file directly — no pytest.
    {
      "name": "🧪 dash-gen: Debug Current Fixture Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "3-verify" }
    },

    // ------------------------------------------------------------------ DOCS
    {
      "name": "📚 MkDocs: Serve (README submodule)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["serve", "--dev-addr=127.0.0.1:8000"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/projects/README",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "4-docs" }
    },
    {
      "name": "🔨 MkDocs: Build Strict (README submodule)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["build", "--strict", "--clean"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/projects/README",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "4-docs" }
    },
    {
      "name": "📚 MkDocs: Serve (ai-seed)",
      "type": "debugpy",
      "request": "launch",
      "module": "mkdocs",
      "args": ["serve", "--dev-addr=127.0.0.1:8001"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/projects/ai-seed",
      "env": { "PYTHONUNBUFFERED": "1" },
      "presentation": { "group": "4-docs", "order": 20 }
    },

    // --------------------------------------------------------------- JEKYLL
    // bundle exec jekyll serve — unique ports so they don't collide with the
    // hub dash on :4000. Needs Bundler gems installed in that submodule.
    {
      "name": "💎 Jekyll: it-journey (:4010)",
      "type": "node-terminal",
