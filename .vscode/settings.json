{
  // ==========================================================================
  // Workspace settings for the hub — shared and machine-neutral.
  //
  // Personal editor preferences (font, line height, minimap, auto-save) live
  // in home.code-workspace or user settings, not here (that file says so).
  // This file carries what the repo itself needs: the submodule cap, the
  // interpreter the debug entries use, Docker Compose v2, file associations
  // for the fleet's stacks, and the ignores that keep search and watching
  // off generated and ephemeral trees.
  // ==========================================================================

  // ---------------------------------------------------------- git/submodules
  // ~40 submodules under projects/. VS Code's default detectSubmodulesLimit is
  // 10, so most never appeared in Source Control. Raise the cap so every
  // submodule is registered.
  "git.detectSubmodules": true,
  "git.detectSubmodulesLimit": 100,
  "git.autoRepositoryDetection": "subFolders",
  "git.openRepositoryInParentFolders": "always",

  // ------------------------------------------------------------------ python
  // The debug entries in launch.json run natively against .venv-console — the
  // venv tools/console/run.sh owns, which carries dash-gen's dependencies too
  // (the "Console: bootstrap venv" task creates it). Test discovery stays off:
  // the hub's test_*.py are plain scripts with their own runner, and the
  // launch/tasks entries run them; the one pytest suite is a task.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv-console/bin/python",
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,
  "python.analysis.extraPaths": [
    ".github/scripts/dash-gen",
    "tools",
    "tools/console",
    "tools/fleetcore",
    "tools/tui"
  ],

  // ------------------------------------------------------------------ docker
  // Compose v2 (`docker compose`); the hub's compose project is pinned to
  // `fleet` in docker-compose.yml (docs/CONTAINERS.md).
  "containers.composeCommand": "docker compose",
  "containers.images.label": "latest",

  // ----------------------------------------------------------------- editing
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.associations": {
    "**/projects/**/*.html": "liquid",
    "*.md": "markdown",
    "*.yml": "yaml",
    "*.yaml": "yaml",
    "_config*.yml": "yaml",
    "docker-compose*.yml": "yaml",
    "Dockerfile*": "dockerfile",
    ".env*": "properties",
    "*.code-workspace": "jsonc"
  },
  "editor.tabCompletion": "on",
  "editor.wordBasedSuggestions": "matchingDocuments",

  // Markdown is one paragraph per line (tools/unwrap-prose.py), so soft-wrap
  // it on screen instead of hard-wrapping it in the file.
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.lineNumbers": "on",
    "editor.quickSuggestions": { "other": true, "comments": true, "strings": true }
  },
  "markdown.preview.breaks": true,
  "markdown.preview.linkify": true,

  "[yaml]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced"
  },
  "yaml.format.enable": true,
  "yaml.completion": true,
  "yaml.hover": true,
  "yaml.validate": true,

  "[liquid]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "liquid.format.enable": true,
  "emmet.includeLanguages": { "liquid": "html" },

  "[javascript][typescript][typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json][jsonc]": {
    "editor.tabSize": 2
  },

  "shellcheck.useWorkspaceRootAsCwd": true,

  // ---------------------------------------------------------------- terminal
  "terminal.integrated.env.osx": {
    "JEKYLL_ENV": "development",
    "DOCKER_BUILDKIT": "1"
  },
  "terminal.integrated.env.linux": {
    "JEKYLL_ENV": "development",
    "DOCKER_BUILDKIT": "1"
  },

  // ---------------------------------------------------------------- copilot
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "yaml": true,
    "liquid": true,
    "html": true,
    "scss": true,
    "javascript": true,
    "python": true,
    "dockerfile": true,
    "json": true,
    "jsonc": true
  },

  // ----------------------------------------------- watching / search / files
  // Generated and ephemeral trees (AGENTS.md "Generated, never hand-edited"):
  // the venvs, the lake, the compose overrides, the built site and page, the
  // evidence bundles. Excluded from watching and search; only the usual
  // caches are hidden from the explorer.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/_site/**": true,
    "**/.sass-cache/**": true,
    "**/.jekyll-cache/**": true,
    "**/vendor/**": true,
    "**/__pycache__/**": true,
    "**/*.pyc": true,
    "**/venv/**": true,
    "**/.venv*/**": true,
    "**/env/**": true,
    "**/dist/**": true,
    "**/dist-pages/**": true,
    "**/.dash-lake/**": true,
    "**/.dash-live/**": true,
    "**/.fleet/**": true,
    "**/test/evidence/**": true
  },
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/_site": true,
    "**/.sass-cache": true,
    "**/.jekyll-cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/_site": true,
    "**/vendor": true,
    "**/__pycache__": true,
    "**/.venv*": true,
    "**/dist": true,
    "**/dist-pages": true,
    "**/.dash-lake": true,
    "**/.dash-live": true,
    "**/.fleet": true,
    "**/test/evidence": true
  },

  // ------------------------------------------------------------ front matter
  "frontMatter.dashboard.openOnStart": false,
  "frontMatter.content.autoUpdateDate": true,

  // ----------------------------------------------------------------- spelling
  "cSpell.words": [
    "actionlint",
    "bamr",
    "barodybroject",
    "debugpy",
    "devenv",
    "endcapture",
    "endraw",
    "fleetcore",
    "Groking",
    "Inkscape",
    "Jamstack",
    "Krita",
    "lastmod",
    "markdownify",
    "MERN",
    "parodynews",
    "Picade",
    "shellcheck",
    "sublinks",
    "uvicorn",
    "winget"
  ]
}
