{
	"folders": [
		{
			"path": "it-journey"
		},
		{
			"path": "lifehacker.dev"
		},
		{
			"path": "bashconsultants"
		}
	],
	"settings": {
		"github.copilot.enable": {
			"*": true,
			"markdown": true,
			"yaml": true,
			"liquid": true,
			"html": true,
			"scss": true,
			"javascript": true,
			"python": true,
			"dockerfile": true,
			"json": true,
			"jsonc": true
		},
		"files.associations": {
			"*.html": "liquid",
			"*.md": "markdown",
			"*.yml": "yaml",
			"*.yaml": "yaml",
			"_config*.yml": "yaml",
			"docker-compose*.yml": "yaml",
			"Dockerfile*": "dockerfile"
		},
		"emmet.includeLanguages": {
			"liquid": "html"
		},
		"terminal.integrated.env.osx": {
			"JEKYLL_ENV": "development",
			"DOCKER_BUILDKIT": "1"
		},
		"terminal.integrated.env.linux": {
			"JEKYLL_ENV": "development",
			"DOCKER_BUILDKIT": "1"
		},
		"frontMatter.dashboard.openOnStart": true,
		"frontMatter.content.autoUpdateDate": true,
		"containers.images.label": "latest",
		"github-actions.workflows.pinned.workflows": [
			".github/workflows/frontmatter-validation.yml"
		]
	}
}