# Harmonize
.harmonize/

# Backup directories
backups/

# Jekyll build artifacts & generated monitoring data (root site)
_site/
.jekyll-cache/
.sass-cache/
_data/project_health.yml
_data/project_health_meta.yml
_data/ai_activity.yml
# Ephemeral agent work order (remediate triage → the fleet-pulse doctor agent).
# Generated per run, never committed. The retired actions-review and
# daily-analysis work orders were removed with their generators (2026-08-09).
remediation-workorder.md
# Ephemeral agent work orders (issue-pipeline scan → the tier 1/2/3 agents).
# Generated per run, uploaded as an artifact, never committed.
issue-workorder-t*.md
# Per-repo briefs written by `dash-gen targets` for repo-evolution.yml; the
# workflow ships them as an artifact, never as a commit.
evolution-workorders/
# local data lake (dash-gen lake): extracted GitHub runs/logs/issues + SQLite; never committed
.dash-lake/
# Evidence sandboxes built by tools/issue-evidence.sh: a full clone plus its
# venv/node_modules per issue. Uploaded as a workflow artifact; never committed.
.evidence/

# Playwright MCP browser artifacts (screenshots, snapshots, downloads)
.playwright-mcp/

# Claude Code machine-local files (never commit: local settings, session worktrees,
# ephemeral dash screenshots from the run-dash skill)
.claude/settings.local.json
.claude/worktrees/
.claude/skills/run-dash/*.png
