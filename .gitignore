# bamr87 hub — what this repository generates, and nothing else.
# (It used to be a copy of a home-directory ignore file; its `github/` pattern
# silently hid tools/console/web/src/github/ from git.)

# ---- dependencies + caches --------------------------------------------------
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
.venv-console/
.venv-mcp/
.venv-tui/
.venv-docs/
*.tsbuildinfo

# ---- lockfiles — never committed: fleet ALWAYS-LATEST dependency policy -----
# (_data/fleet.yml `dependencies:` + docs/DEPENDENCIES.md)
package-lock.json
npm-shrinkwrap.json
pnpm-lock.yaml
yarn.lock
Gemfile.lock
poetry.lock
Pipfile.lock
uv.lock
composer.lock
# BEGIN sanctioned_lockfiles: generated from specs/QUALITY.contract.yml
# (UPS-QA-40 hub-only exception). One `!<lockfile>` per entry, after the
# patterns above; tools/check-drift.sh (j) fails when this block drifts.
!.github/site-quality/package-lock.json
# END sanctioned_lockfiles

# ---- build outputs -----------------------------------------------------------
# _site/: the public site as build-dash.yml builds it (tools/console/build-pages.sh)
_site/
dist/
dist-pages/
site/
build/
*.egg-info/

# ---- generated data that is never committed ----------------------------------
_data/project_health.yml
_data/project_health_meta.yml
_data/ai_activity.yml
# Ephemeral agent work orders: remediate → the fleet-pulse doctor; the
# issue-pipeline tiers; dash-gen targets → repo-evolution.yml. Each is shipped as
# a workflow artifact, never as a commit.
remediation-workorder.md
issue-workorder-t*.md
evolution-workorders/
scout-workorders/
# The local data lake (dash-gen lake) — it holds run logs.
.dash-lake/
# Per-submodule compose overrides generated by `dash-gen compose`.
.fleet/compose/
# Evidence sandboxes built by tools/issue-evidence.sh.
.evidence/
# The agent verification loop's exchange files (fleet-verify.yml /
# verify/runner.mjs). Evidence BUNDLES under test/evidence/<slug>/ are
# committed deliberately (docs/VERIFICATION.md).
verify/BRIEF.md
verify/AGENT-REPORT.md
test/evidence/agent/
test/evidence/report.json
verify-app.log
verify-run.txt
mkdocs-build.log

# ---- secrets + machine-local ------------------------------------------------
.env
.env.local
.env.*.local
.claude/settings.local.json
.claude/worktrees/
.claude/skills/run-dash/*.png
.playwright-mcp/
.codex/
.frontmatter/
.harmonize/

# ---- editors + OS -----------------------------------------------------------
# .vscode/ is ignored except the shared config this repo deliberately tracks
# (notably the raised git.detectSubmodulesLimit the ~45 submodules need).
.vscode/*
!.vscode/README.md
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
*.log

# Host-side process snapshot for the console /live page (tools/console/live_collector.py).
.dash-live/
