# Global Git Ignore File

# Project-specific: ensure scripts/ is tracked (some global patterns previously hid it)
!scripts/
!scripts/**
!scripts/*.py
!scripts/*.sh
!scripts/*.zsh
!scripts/*.ps1

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd

# Lockfiles — never committed: fleet ALWAYS-LATEST dependency policy
# (_data/fleet.yml `dependencies:` + docs/DEPENDENCIES.md)
package-lock.json
npm-shrinkwrap.json
pnpm-lock.yaml
yarn.lock
Gemfile.lock
poetry.lock
Pipfile.lock
uv.lock
composer.lock

# Build outputs
site/
dist/
build/
*.egg-info/
.eggs/
target/
out/

# Jekyll build artifacts
_site/
.jekyll-cache/
.jekyll-metadata

# Virtual Environments
.venv/
venv/
.venv-console/
ENV/
env/
.virtualenv/

# IDE & Editors
# .vscode/ is ignored by default, but this repo intentionally tracks its shared
# workspace config (notably the raised git.detectSubmodulesLimit that the ~40
# submodules require). Without these negations, new files added here are
# silently invisible to git.
.vscode/
!.vscode/README.md
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pip-log.txt
mkdocs-build.log

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

