}

cmd_status() {
  echo "${c_bold}== Submodules ==${c_off}"
  git -C "$ROOT" submodule status || true
  echo
  echo "${c_bold}== Registry ==${c_off}"
  if command -v python3 >/dev/null; then
    python3 - "$ROOT/_data/projects.yml" <<'PY'
import sys, yaml
with open(sys.argv[1]) as fh:
    reg = yaml.safe_load(fh) or []
print(f"  {len(reg)} projects "
      f"({sum(1 for p in reg if p.get('submodule_path'))} submodules, "
      f"{sum(1 for p in reg if p.get('featured'))} featured, "
      f"{sum(1 for p in reg if p.get('status')=='active')} active)")
PY
  fi
  echo
  echo "${c_bold}== Drift ==${c_off}"
  "${TOOLS}/check-drift.sh" --report || true
}

cmd_monitor() {
  "${TOOLS}/dash-gen" health
  local health="${ROOT}/_data/project_health.yml"
  [[ -f "$health" ]] || { echo "no health data"; return 1; }
  python3 - "$health" <<'PY'
import sys, yaml
data = yaml.safe_load(open(sys.argv[1])) or []
order = {"red":0,"amber":1,"green":2}
for h in sorted(data, key=lambda x: x.get("attention_rank", 2)):
    lvl = h["attention"]["level"]
    dot = {"red":"🔴","amber":"🟠","green":"🟢"}[lvl]
    if lvl == "green":
        continue
    print(f'{dot} {h["name"]:<22} {"; ".join(h["attention"]["reasons"])}')
green = sum(1 for h in data if h["attention"]["level"]=="green")
print(f'\n🟢 {green} healthy / {len(data)} total')
PY
}

cmd_serve() {
  cd "$ROOT"
  if docker compose ps >/dev/null 2>&1; then
    docker compose up -d devenv
    docker compose exec devenv bash -lc \
      'cd /workspace && bundle install && bundle exec jekyll serve -H 0.0.0.0 -c _config.yml,_config_dev.yml'
  else
    echo "Docker not available; serving natively."
    cd "$ROOT" && bundle install && bundle exec jekyll serve -c _config.yml,_config_dev.yml
  fi
}

# The Harness Console: the credentialed, write-capable front end of the local
# stack (the Jekyll dash is its read-only twin). Native runs bootstrap a venv
# via tools/console/run.sh; --docker starts the compose service instead.
cmd_console() {
  if [[ "${1:-}" == "--docker" ]]; then
    shift
    cd "$ROOT" && docker compose up -d console "$@"
    echo "console: http://127.0.0.1:${CONSOLE_PORT:-4001}/  (docker compose logs -f console)"
  else
    "${TOOLS}/console/run.sh" "$@"
  fi
}

cmd_sync() {
  "${TOOLS}/update-submodules.sh" "$@"
  "${TOOLS}/dash-gen" all
}

cmd_run() {
  [[ $# -ge 1 ]] || { echo "usage: dash run <tool> [args]"; return 1; }
  local tool="$1"; shift
  for cand in "${SCRIPTS}/${tool}" "${SCRIPTS}/${tool}.sh" "$(command -v "$tool" 2>/dev/null || true)"; do
    if [[ -n "$cand" && -x "$cand" ]]; then exec "$cand" "$@"; fi
  done
  echo "tool not found in scripts/: ${tool}" >&2
  echo "available:" >&2; ls "${SCRIPTS}" 2>/dev/null | sed 's/^/  /' >&2
  return 1
}

cmd_new() {
  [[ $# -ge 1 ]] || { echo "usage: dash new <name> [project-init args]"; return 1; }
  local name="$1"; shift
  if [[ -x "${SCRIPTS}/project-init.sh" ]]; then
    "${SCRIPTS}/project-init.sh" "$name" "$@"
  else
    echo "scripts/project-init.sh not found (is the submodule initialized?)" >&2
    return 1
  fi
  echo
  echo "${c_dim}Remember to register '${name}' in _data/projects.yml"
  echo "(or run the .claude/skills/update-registry skill).${c_off}"
}

cmd_evolve() {
  if ! command -v gh >/dev/null; then
    echo "gh CLI required to trigger evolution workflows" >&2
    return 1
  fi
  # Two evolution layers. Bare `dash evolve` is the hub's own dispatch-only
  # pass; `--repo` / `--all` dispatch the weekly repo-evolution loop, whose
  # plan step decides what actually runs (registry opt-in, owned upstream, not
  # archived, no evolution PR still open). Extra args pass through to `gh
  # workflow run` — e.g. `-f dry_run=true`, `-f force=true`, `-f focus='...'`.
  case "${1:-}" in
    --repo)
      shift
      local repo="${1:?usage: dash evolve --repo <name> [-f dry_run=true] [-f force=true] [-f focus=...]}"; shift || true
      gh workflow run repo-evolution.yml -f "target=${repo}" "$@"
      ;;
    --all)
      shift
      gh workflow run repo-evolution.yml -f "target=all" "$@"
      ;;
    *)
      gh workflow run unified-evolution.yml "$@"
      ;;
  esac
}

cmd_audit()  { "${TOOLS}/audit-standards.sh" "$@"; }

# Run a shell command in every checked-out submodule (continue on error).
cmd_foreach() {
  [[ $# -ge 1 ]] || { echo "usage: dash foreach <command...>"; return 1; }
  local cmd="$*" rc=0 name dir
  while IFS= read -r sp; do
    dir="${ROOT}/${sp}"
    name="$(basename "$sp")"
    if [[ ! -d "$dir" ]] || [[ -z "$(ls -A "$dir" 2>/dev/null)" ]]; then
      echo "${c_dim}-- skip ${name} (not checked out)${c_off}"; continue
    fi
    echo "${c_bold}== ${name} ==${c_off}"
    ( cd "$dir" && name="$name" sm_path="$sp" bash -c "$cmd" ) || { rc=1; echo "${c_dim}   (exit $?)${c_off}"; }
  done < <(git -C "$ROOT" config -f .gitmodules --get-regexp '\.path$' | awk '{print $2}')
  return $rc
}

# Active-tier, non-fork submodule names (the release/protect candidates).
_active_repos() {
  "${TOOLS}/audit-standards.sh" --json --no-color 2>/dev/null \
    | python3 -c 'import sys,json;print("\n".join(r["name"] for r in json.load(sys.stdin)["rows"] if r["tier"]=="active"))'
}

cmd_adopt_release() {
  if [[ "${1:-}" == "--all" ]]; then
    shift
    local r
    for r in $(_active_repos); do
      echo "${c_bold}== adopt-release: ${r} ==${c_off}"
      "${TOOLS}/adopt-release.sh" "$r" "$@" || echo "${c_dim}   (skipped ${r})${c_off}"
    done
  else
    "${TOOLS}/adopt-release.sh" "$@"
  fi
}

cmd_protect() {
  if [[ "${1:-}" == "--all" ]]; then
    shift
    local r
    for r in $(_active_repos); do
      echo "${c_bold}== protect: ${r} ==${c_off}"
      "${TOOLS}/protect-branch.sh" "$r" "$@" || echo "${c_dim}   (skipped ${r})${c_off}"
    done
  else
    "${TOOLS}/protect-branch.sh" "$@"
  fi
}

cmd_ai() {
  # `dash ai` shadow-prices local Claude Code usage; `dash ai check` audits
  # that ledger against ccusage; `dash ai run -- <args>` runs `claude -p` under
  # the dollar cap from _data/fleet.yml and records what it cost. Same
  # case-dispatch shape as cmd_secrets below — the bare verb must keep behaving
  # exactly as it did before the subcommands existed, so anything unrecognised
  # falls through to `dash-gen ai`.
  case "${1:-}" in
    check) shift; "${TOOLS}/dash-gen" ai-check "$@" ;;
    run) shift; "${TOOLS}/dash-gen" ai-run "$@" ;;
    *) "${TOOLS}/dash-gen" ai "$@" ;;
  esac
}
cmd_actions() { "${TOOLS}/dash-gen" actions "$@"; }
cmd_daily() { "${TOOLS}/dash-gen" daily "$@"; }
cmd_triage() { "${TOOLS}/dash-gen" triage "$@"; }
cmd_reconcile() { "${TOOLS}/dash-gen" reconcile "$@"; }
cmd_vendor()    { "${TOOLS}/dash-gen" vendor "$@"; }
cmd_remediate() { "${TOOLS}/dash-gen" remediate "$@"; }
cmd_harness() { "${TOOLS}/dash-gen" harness "$@"; }
# The fleet-wide AI-harness inventory (plural — `dash harness` above is the
# hub's own scorecard). `deploy` reuses the standardize fan-out engine with the
# agent-context kit artifacts, so it inherits every fanout.sh guarantee:
# dry-run default, PRs only, external-upstream guard, additive-only seeding,
# --upgrade only for byte-identical machine seeds.
cmd_harnesses() {
  case "${1:-}" in
    gaps)   shift; "${TOOLS}/dash-gen" harnesses --gaps "$@" ;;
    deploy) shift; harnesses_deploy "$@" ;;
    *)      "${TOOLS}/dash-gen" harnesses "$@" ;;
  esac
}
harnesses_deploy() {
  local artifacts="claude" targets=() use_gaps=0 apply=() upgrade=() t
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --gaps)      use_gaps=1 ;;
      --target)    targets+=("${2:?--target needs a value}"); shift ;;
      --artifacts) artifacts="${2:?--artifacts needs a value}"; shift ;;
      --apply)     apply=(--apply) ;;
      --upgrade)   upgrade=(--upgrade) ;;
      *) echo "unknown flag: $1 (usage: dash harnesses deploy [--gaps] [--target <name>]... [--artifacts csv] [--upgrade] [--apply])" >&2; return 2 ;;
    esac
    shift
  done
  if [[ "$use_gaps" -eq 1 ]]; then
    while IFS= read -r t; do
      [[ -n "$t" ]] && targets+=("$t")
    done < <("${TOOLS}/dash-gen" harnesses --gaps)
  fi
  if [[ ${#targets[@]} -eq 0 ]]; then
    echo "no deploy targets — pass --target <name>, or --gaps after \`dash harnesses\` has produced _data/harness_registry.yml"
    return 0
  fi
  for t in "${targets[@]}"; do
    "${TOOLS}/fanout.sh" --kit standardize --target "$t" --artifacts "$artifacts" \
      ${apply[@]+"${apply[@]}"} ${upgrade[@]+"${upgrade[@]}"}
  done
}
cmd_spec() {
  # `dash spec check [path] [--kinds …] [--gate]` — one repo against the UPS;
  # `dash spec fleet [--write]` — every checked-out submodule → _data/conformance.yml
  # (the file the repo-evolution brief reads); `dash spec kinds [path]`.
  local sub="${1:-check}"
  case "$sub" in
    check|fleet|kinds) shift; python3 "${TOOLS}/conformance.py" "$sub" "$@" ;;
    *) python3 "${TOOLS}/conformance.py" check "$@" ;;
  esac
}
cmd_issues() { "${TOOLS}/dash-gen" issues "$@"; }
cmd_evidence() {
  # `dash evidence bamr87/repo 42 [extra flags]` — positional repo + issue, so
  # the everyday invocation matches how you'd say it out loud.
  local repo="${1:-}" num="${2:-}"
  if [ -z "$repo" ] || [ -z "$num" ]; then
    echo "usage: dash evidence <owner/repo> <issue-number> [--ref REF] [--out DIR] [--no-screenshot]" >&2
    return 1
  fi
  shift 2
  "${TOOLS}/issue-evidence.sh" --repo "$repo" --issue "$num" "$@"
}
cmd_secrets() {
  # `dash secrets` audits; `sync` provisions the token contract; `rotate` runs
  # the weekly credential loop and `plan` is its read-only half. Values come
  # from the environment only — see fleet-config.py.
  case "${1:-}" in
    sync) shift; python3 "${TOOLS}/fleet-config.py" sync-secrets "$@" ;;
    rotate) shift; python3 "${TOOLS}/fleet-config.py" rotate "$@" ;;
    plan) shift; python3 "${TOOLS}/fleet-config.py" rotation-plan "$@" ;;
    *) python3 "${TOOLS}/fleet-config.py" audit "$@" ;;
  esac
}
cmd_config() {
  # `dash config` with no subcommand prints the resolved config; otherwise it
  # forwards show/audit/sync straight through.
  local sub="${1:-show}"
  case "$sub" in
    show|audit|sync) shift; python3 "${TOOLS}/fleet-config.py" "$sub" "$@" ;;
    sync-secrets|rotate|rotation-plan) shift; python3 "${TOOLS}/fleet-config.py" "$sub" "$@" ;;
    *) python3 "${TOOLS}/fleet-config.py" show "$@" ;;
  esac
}
cmd_estimate() { "${TOOLS}/dash-gen" estimate "$@"; }
cmd_ledger() { "${TOOLS}/dash-gen" ledger "$@"; }
# The local data lake + trace export (local stack; docs/HARNESS-OPS.md).
# Two EXTRACT commands, one for each plane Claude runs in, then one analysis:
#   dash lake sync      CI plane — GitHub runs/jobs/steps/logs/issues/workflows/.factory → .dash-lake/
#   dash lake sessions  local plane — ~/.claude/projects transcripts → sessions/turns/tool calls
#   dash lake review    analyze both planes offline (cost, turns, tools, failures, findings)
#   dash lake status    what the lake holds + Phoenix reachability
#   dash lake export    OpenInference traces → Phoenix (docker compose up -d phoenix)
cmd_lake() { "${TOOLS}/dash-gen" lake "$@"; }

# The local LOG plane (docs/OBSERVABILITY.md). Phoenix holds traces, Grafana
# draws trends, Elasticsearch/Kibana hold the raw text of what CI and the
# containers actually said. up/down/open drive docker + the browser, so they
# live here; ship/status/verify are the generator's.
#   dash observe up        start the elk profile, then install ILM + dashboards
#   dash observe ship      replay the lake's Actions logs into Logstash (ECS)
#   dash observe status    every plane's health, dataset sizes vs the budget
#   dash observe verify    re-render ILM/templates from fleet.yml and diff
#   dash observe open      the Harness Console's Observe tab — the one front door
#   dash observe reset     destroy the indices and volumes (asks first)
# The five services are NAMED rather than left to the profile: a bare
# `--profile elk up` also starts everything in the DEFAULT profile (devenv,
# console, wiki, db…), so "start the log plane" would quietly start the whole
# bench and fight for its ports. test_observe_contract.py holds this list equal
# to the profile's membership.
ELK_SERVICES=(elasticsearch logstash kibana filebeat grafana)

cmd_observe() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    up)
      cd "$ROOT" || return 1
      docker compose --profile elk up -d "${ELK_SERVICES[@]}" || return 1
      echo "waiting for elasticsearch + kibana to report healthy…"
      "${TOOLS}/observability/bootstrap.sh"
      ;;
    down)
      cd "$ROOT" && docker compose --profile elk stop "${ELK_SERVICES[@]}"
      ;;
    open)
      local url="http://127.0.0.1:${CONSOLE_PORT:-4001}/#observe"
      echo "opening ${url}"
      command -v open >/dev/null 2>&1 && open "$url" || echo "open ${url}"
      ;;
    reset)
      # Destructive, and NARROWLY so. `docker compose down -v` would remove
      # every named volume in the file — db-data, wiki-data, phoenix-data
      # included — which is not what "reset the log plane" can be allowed to
      # mean. So: remove the five containers, then the five volumes BY NAME.
      cd "$ROOT" || return 1
      local answer="${1:-}"
      if [[ "$answer" != "--yes" ]]; then
        printf 'Destroy every indexed log line and the 5 elk volumes? [y/N] '
        read -r answer
        [[ "$answer" == [yY]* ]] || { echo "aborted"; return 1; }
      fi
      docker compose --profile elk rm -sf "${ELK_SERVICES[@]}" || true
      local proj vol
      proj="$(docker compose config --format json 2>/dev/null \
              | "${PYTHON:-python3}" -c 'import json,sys; print(json.load(sys.stdin)["name"])' 2>/dev/null)"
      if [[ -z "$proj" ]]; then
        echo "could not resolve the compose project name — volumes left alone" >&2
        return 1
      fi
      for vol in es-data logstash-data kibana-data filebeat-data grafana-data; do
        docker volume rm -f "${proj}_${vol}" >/dev/null 2>&1 \
          && echo "  removed ${proj}_${vol}" || true
      done
      ;;
    status|ship|verify) "${TOOLS}/dash-gen" observe "$sub" "$@" ;;
    *) "${TOOLS}/dash-gen" observe "$sub" "$@" ;;
  esac
}
# The fleet's container plane (docs/CONTAINERS.md). The hub runs the shared
# half — workspace, console, one Postgres, one Redis — on a network named
# `fleet`; every submodule stays its OWN compose project and joins that network
# through a generated override, which is why `up` is a loop over `docker
# compose` rather than one big project. (`include:` cannot do this: it merges
# by service name, and five submodules define `jekyll`.)
#
#   dash up                     the shared core
#   dash up it-journey law-ai   …plus those projects
#   dash up --group jekyll      …plus a group from _data/fleet.yml
#   dash up --all [--force]     …everything registered, capped by max_projects
#   dash down [--all]           stop the core, or everything
#   dash ps                     what is running, fleet-wide
FLEET_PROFILES_DEFAULT=""

_fleet_targets() {  # echoes: slug<TAB>dir<TAB>base<TAB>override
  "${TOOLS}/dash-gen" compose --resolve "$@"
}

_fleet_up_one() {  # $1 slug, $2 dir, $3 base compose, $4 override
  local slug="$1" dir="$2" base="$3" ovr="$4"
  if [[ ! -f "$ROOT/$ovr" ]]; then
    echo "  ✗ ${slug}: no override at ${ovr} — run: tools/dash gen compose" >&2
    return 1
  fi
  echo "  → ${slug}"
  local out rc=0
  out="$( cd "$ROOT" && docker compose -p "$slug" --project-directory "$dir" \
            -f "$base" -f "$ovr" up -d 2>&1 )" || rc=$?
  echo "$out" | sed 's/^/      /'
  [[ $rc -eq 0 ]] && return 0

  # A project that requires its own .env is the most common way this fails,
  # and compose's message names an absolute path without saying what to do
  # about it. Name the fix instead.
  if [[ "$out" == *"env file"*"not found"* ]]; then
    echo "  ✗ ${slug}: needs its own .env" >&2
    if [[ -f "$ROOT/$dir/.env.example" ]]; then
      echo "      fix: cp ${dir}/.env.example ${dir}/.env" >&2
    else
      echo "      fix: touch ${dir}/.env   (the project requires one; it has no example)" >&2
    fi
    echo "      (a pre-existing requirement of that repo, not of the fleet plane)" >&2
  else
    echo "  ✗ ${slug}: failed to start (see above)" >&2
  fi
  return 1
}

cmd_up() {
  local all=0 force=0 group="" profiles="${FLEET_PROFILES:-$FLEET_PROFILES_DEFAULT}"
  # Declared BEFORE the parse loop that fills them — declaring them after it
  # resets what it just collected, which reads as "no projects named".
  local names=(); local spec=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all)     all=1; shift ;;
      --force)   force=1; shift ;;
      --group)   group="${2:-}"; shift 2 ;;
      --profile) profiles="${profiles} ${2:-}"; shift 2 ;;
      -*)        echo "unknown flag: $1" >&2; return 2 ;;
      *)         names+=("$1"); shift ;;
    esac
  done

  cd "$ROOT" || return 1

  # 1. The shared core, always. Everything else needs its network and its db.
  echo "fleet core:"
  local pargs=()
  for pr in $profiles; do pargs+=(--profile "$pr"); done
  docker compose ${pargs[@]+"${pargs[@]}"} up -d 2>&1 | sed 's/^/  /'

  # 2. Per-project databases, idempotently. The init directory only runs on a
  #    FRESH volume, so a db-data that predates a project would never get one.
  local initsh="${TOOLS}/fleet/db-init/10-fleet-databases.sh"
  if [[ -f "$initsh" ]]; then
    echo "fleet databases:"
    docker compose exec -T db bash -s < "$initsh" 2>&1 | sed 's/^/  /' \
      || echo "  (skipped — db not ready yet; re-run \`tools/dash up\` once it is)"
  fi

  # 3. The projects.
  [[ "$all" -eq 1 ]] && spec+=(--all)
  [[ "$force" -eq 1 ]] && spec+=(--force)
  [[ -n "$group" ]] && spec+=(--group "$group")
  [[ ${#names[@]} -gt 0 ]] && spec+=(${names[@]+"${names[@]}"})
  if [[ ${#spec[@]} -eq 0 ]]; then
    echo
    echo "core only. Add projects: tools/dash up <name>… | --group <name> | --all"
    return 0
  fi

  local targets rc=0
  targets="$(_fleet_targets ${spec[@]+"${spec[@]}"})" || return 1
  [[ -n "$targets" ]] || { echo "no matching projects."; return 0; }
  echo "projects:"
  while IFS=$'\t' read -r slug dir base ovr; do
    [[ -n "$slug" ]] || continue
    _fleet_up_one "$slug" "$dir" "$base" "$ovr" || rc=1
  done <<< "$targets"
  return $rc
}

cmd_down() {
  local all=0; local volumes=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=1; shift ;;
      -v|--volumes) volumes+=(-v); shift ;;
      *) shift ;;
    esac
  done
  cd "$ROOT" || return 1
  if [[ "$all" -eq 1 ]]; then
    echo "projects:"
    while IFS=$'\t' read -r slug dir base ovr; do
      [[ -n "$slug" ]] || continue
      echo "  ← ${slug}"
      docker compose -p "$slug" --project-directory "$dir" -f "$base" -f "$ovr" \
        down ${volumes[@]+"${volumes[@]}"} 2>&1 | sed 's/^/      /' || true
    done <<< "$(_fleet_targets --all --force)"
  fi
  # The core LAST: it owns the network every project above is attached to, and
  # docker will not remove a network that still has endpoints on it.
  echo "fleet core:"
  docker compose --profile traces --profile docs --profile admin --profile elk \
    down ${volumes[@]+"${volumes[@]}"} 2>&1 | sed 's/^/  /'
}

cmd_ps() {
  local net; net="$("${TOOLS}/fleet-config.py" show containers.network 2>/dev/null || echo fleet)"
  printf '%-26s %-34s %s\n' "PROJECT" "SERVICE" "STATUS / PORTS"
  docker ps -a --filter "label=com.docker.compose.project" \
    --format '{{.Label "com.docker.compose.project"}}\t{{.Label "com.docker.compose.service"}}\t{{.Status}}\t{{.Ports}}' \
    | sort | while IFS=$'\t' read -r proj svc status ports; do
        printf '%-26s %-34s %s  %s\n' "$proj" "$svc" "$status" "${ports:0:60}"
      done
  echo
  echo "network ${net}:"
  docker network inspect "$net" --format '{{range .Containers}}  {{.Name}} {{.IPv4Address}}
{{end}}' 2>/dev/null || echo "  (not created — run: tools/dash up)"
}

cmd_doctor() { "${TOOLS}/setup.sh" --dry-run "$@"; }
cmd_test()   { "${TOOLS}/run-all-tests.sh" "$@"; }
cmd_gen()    { "${TOOLS}/dash-gen" "$@"; }

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    status)  cmd_status "$@" ;;
    audit)   cmd_audit "$@" ;;
    monitor) cmd_monitor "$@" ;;
    actions) cmd_actions "$@" ;;
    daily)   cmd_daily "$@" ;;
    triage)  cmd_triage "$@" ;;
    reconcile) cmd_reconcile "$@" ;;
    vendor) cmd_vendor "$@" ;;
    remediate) cmd_remediate "$@" ;;
    harness) cmd_harness "$@" ;;
    harnesses) cmd_harnesses "$@" ;;
    spec)    cmd_spec "$@" ;;
    issues)  cmd_issues "$@" ;;
    evidence) cmd_evidence "$@" ;;
    secrets) cmd_secrets "$@" ;;
    config)  cmd_config "$@" ;;
    estimate) cmd_estimate "$@" ;;
    ledger)  cmd_ledger "$@" ;;
    lake)    cmd_lake "$@" ;;
    observe) cmd_observe "$@" ;;
    up)      cmd_up "$@" ;;
    down)    cmd_down "$@" ;;
    ps)      cmd_ps "$@" ;;
    serve)   cmd_serve "$@" ;;
    console) cmd_console "$@" ;;
    sync)    cmd_sync "$@" ;;
    foreach) cmd_foreach "$@" ;;
    run)     cmd_run "$@" ;;
    new)     cmd_new "$@" ;;
    adopt-release) cmd_adopt_release "$@" ;;
    protect) cmd_protect "$@" ;;
    evolve)  cmd_evolve "$@" ;;
    ai)      cmd_ai "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    test)    cmd_test "$@" ;;
    gen)     cmd_gen "$@" ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: ${cmd}" >&2; usage; return 1 ;;
  esac
}

main "$@"
