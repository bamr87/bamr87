{
  "description": "Trends over the fleet log plane (retention: actions 90d, app 30d, claude 90d, container 14d). GENERATED by `dash observe verify --write` from _data/fleet.yml \u2014 edit the contract, not this file. Search the same data in Kibana; per-run traces are in Phoenix.",
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "panels": [],
      "title": "Claude Code \u2014 live (Prometheus, from native OTel)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "Claude Code's own cost estimate across every session in the range.",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 11,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum(increase(claude_code_cost_usage_USD_total[$__range] anchored))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Spend in range",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "Share of prompt tokens served from the prompt cache. Low means context is being re-sent rather than reused.",
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 12,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[$__range] anchored)) / sum(increase(claude_code_token_usage_tokens_total{type=~\"input|cacheRead|cacheCreation\"}[$__range] anchored))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Cache read share",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "claude_code.session.count \u2014 fresh, resumed and continued.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 13,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum(increase(claude_code_session_count_total[$__range] anchored))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Sessions started",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "Keyboard time plus tool/model time (claude_code.active_time.total).",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 14,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum(increase(claude_code_active_time_seconds_total[$__range] anchored))",
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Active time",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "How fast spend is accruing right now, per model.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 15,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum by (model) (rate(claude_code_cost_usage_USD_total[$__rate_interval] anchored)) * 3600",
          "instant": false,
          "legendFormat": "{{model}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Burn rate by model (USD/hour)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "input excludes the cache; cacheRead and cacheCreation are the cache's two sides.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 16,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total[$__rate_interval] anchored))",
          "instant": false,
          "legendFormat": "{{type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tokens by type",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "query_source: main (the conversation), subagent, auxiliary (titles, summaries), sdk (headless runs).",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 17,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum by (query_source) (increase(claude_code_cost_usage_USD_total[$__range] anchored))",
          "instant": true,
          "legendFormat": "{{query_source}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Spend by source in range",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "fleet-prometheus"
      },
      "description": "vcs.repository.name \u2014 needs Claude Code \u2265 2.1.269 with OTEL_METRICS_INCLUDE_REPOSITORY (contract: attributes.repository). Empty on older versions.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 18,
      "options": {
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "sum by (vcs_repository_name) (increase(claude_code_cost_usage_USD_total[$__range] anchored))",
          "instant": true,
          "legendFormat": "{{vcs_repository_name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Spend by repository in range",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "id": 9,
      "panels": [],
      "title": "Fleet log plane (Elasticsearch)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "Documents/interval across every dataset \u2014 the shape of what the fleet is saying.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "id": 1,
      "targets": [
        {
          "alias": "{{fleet.repo}}",
          "bucketAggs": [
            {
              "field": "fleet.repo",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "*",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Log volume by repo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "log.level is inferred for unstructured lines too, so this covers all three datasets.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "id": 2,
      "targets": [
        {
          "alias": "{{log.level}}",
          "bucketAggs": [
            {
              "field": "log.level",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "5"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "log.level:(\"error\" OR \"warn\")",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Errors and warnings",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "Summed from the one summary document per AI run \u2014 the per-line documents carry the same fields and would multiply the total by line count.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "id": 3,
      "targets": [
        {
          "alias": "{{llm.model}}",
          "bucketAggs": [
            {
              "field": "llm.model",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "field": "llm.cost_usd",
              "id": "1",
              "type": "sum"
            }
          ],
          "query": "event.module:\"claude.agent\"",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Agent spend by model (USD)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "The same signal fleet_triage.yml ranks, but continuous.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "id": 4,
      "targets": [
        {
          "alias": "{{ci.workflow}}",
          "bucketAggs": [
            {
              "field": "ci.workflow",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "ci.conclusion:\"failure\"",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "CI failures by workflow",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "fleet",
    "logs",
    "generated"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Fleet log volume & cost",
  "uid": "fleet-logs",
  "version": 1
}
