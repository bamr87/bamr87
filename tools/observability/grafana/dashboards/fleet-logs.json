{
  "description": "Trends over the fleet log plane (retention: actions 90d, app 30d, container 14d). GENERATED by `dash observe verify --write` from _data/fleet.yml \u2014 edit the contract, not this file. Search the same data in Kibana; per-run traces are in Phoenix.",
  "panels": [
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "Documents/interval across every dataset \u2014 the shape of what the fleet is saying.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "alias": "{{fleet.repo}}",
          "bucketAggs": [
            {
              "field": "fleet.repo",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "*",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Log volume by repo",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "log.level is inferred for unstructured lines too, so this covers all three datasets.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "alias": "{{log.level}}",
          "bucketAggs": [
            {
              "field": "log.level",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "5"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "log.level:(\"error\" OR \"warn\")",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Errors and warnings",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "Summed from the one summary document per AI run \u2014 the per-line documents carry the same fields and would multiply the total by line count.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "alias": "{{llm.model}}",
          "bucketAggs": [
            {
              "field": "llm.model",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "field": "llm.cost_usd",
              "id": "1",
              "type": "sum"
            }
          ],
          "query": "event.module:\"claude.agent\"",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "Agent spend by model (USD)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "elasticsearch",
        "uid": "fleet-elasticsearch"
      },
      "description": "The same signal fleet_triage.yml ranks, but continuous.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "alias": "{{ci.workflow}}",
          "bucketAggs": [
            {
              "field": "ci.workflow",
              "id": "3",
              "settings": {
                "order": "desc",
                "orderBy": "_count",
                "size": "10"
              },
              "type": "terms"
            },
            {
              "field": "@timestamp",
              "id": "2",
              "settings": {
                "interval": "auto",
                "min_doc_count": "0"
              },
              "type": "date_histogram"
            }
          ],
          "datasource": {
            "type": "elasticsearch",
            "uid": "fleet-elasticsearch"
          },
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ],
          "query": "ci.conclusion:\"failure\"",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ],
      "title": "CI failures by workflow",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "fleet",
    "logs",
    "generated"
  ],
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Fleet log volume & cost",
  "uid": "fleet-logs",
  "version": 1
}
