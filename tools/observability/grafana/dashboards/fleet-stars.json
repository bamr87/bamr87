      },
      "description": "Each point is the day's highest count: one push a refresh (daily while the loop runs) lives an hour in the collector, so a daily window draws a continuous line. A line starts the day the repo joined the radar.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
