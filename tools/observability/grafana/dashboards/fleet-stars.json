          "datasource": {
            "type": "prometheus",
            "uid": "fleet-prometheus"
          },
          "expr": "max by (repo) (max_over_time(fleet_stars_repo_stars{starred=\"true\"}[1d])) and on (repo) topk(10, max by (repo) (last_over_time(fleet_stars_repo_stars{starred=\"true\"}[2d])))",
          "format": "time_series",
          "legendFormat": "{{repo}}",
          "refId": "A"
        }
      ],
      "title": "Stars over time: the ten most-starred of your stars",
