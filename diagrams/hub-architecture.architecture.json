  "cards": [
    {
      "dot": "cyan",
      "title": "One direction of data",
      "items": [
        "Registries are written by hand; every other file is a projection",
        "Generators are deterministic and run offline from fixtures",
        "The drift gate fails a PR when a projection disagrees"
      ]
    },
    {
      "dot": "emerald",
      "title": "Who may write",
      "items": [
        "Tools are read-only by default; writes go plan, confirm, apply",
        "Every loop has a kill switch, a budget cap and a ledger",
        "Agents open pull requests; only the maintainer merges"
      ]
    },
    {
      "dot": "amber",
      "title": "What holds the shape",
      "items": [
        "A unit imports from its own layer or a lower one, never up",
        "A source file stays under 1,500 lines; larger ones sit in a ledger that only shrinks",
        "tools/focus.py names the checks a change owes, in one pass"
      ]
    }
  ]
