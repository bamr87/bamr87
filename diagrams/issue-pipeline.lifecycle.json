    "views": [
      {
        "id": "three-tiers",
        "label": "The three tiers",
        "focus": [
          "queued",
          "intake",
          "ready",
          "in_pr",
          "done"
        ],
        "note": "T1 intake, T2 implement, T3 complete — each run resumes from the current label, so a missed run costs latency, not a stuck issue."
      },
      {
        "id": "human-brakes",
        "label": "The two human brakes",
        "focus": [
          "ready",
          "hold",
          "in_pr",
          "review"
        ],
        "note": "agent:hold pauses anything; human-review keeps T3 from marking a PR ready."
      },
      {
        "id": "never-merges",
        "label": "No tier ever merges",
        "focus": [
          "done",
          "review",
          "merged"
        ],
        "note": "Merge is a human action in every path."
      }
    ]
  },
