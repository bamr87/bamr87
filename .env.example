# ============================================================================
# bamr87 Monorepo - Environment Configuration
# ============================================================================
#
# Copy this file to .env and edit with your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# AI (optional, local only — CI uses GitHub repo secrets instead;
# see docs/AI-INTEGRATION.md for the full auth matrix)
# ---------------------------------------------------------------------------
# Claude Code OAuth token (`claude setup-token`) — preferred auth everywhere
#CLAUDE_CODE_OAUTH_TOKEN=
# Claude API key — fallback when no OAuth token is provisioned
#ANTHROPIC_API_KEY=
# GitHub token for the github MCP server (.mcp.json) and dash-gen generators
#GITHUB_TOKEN=
# Fleet-wide fine-grained PAT (the control plane's one token — _data/fleet.yml
# `tokens:`); the Harness Console passes it through to its jobs as GH_TOKEN
#FLEET_TOKEN=

# ---------------------------------------------------------------------------
# CV Builder (Vite / React)
# ---------------------------------------------------------------------------
CV_PORT=5000
VITE_HMR_PORT=5173

# ---------------------------------------------------------------------------
# MkDocs / Documentation
# ---------------------------------------------------------------------------
MKDOCS_PORT=8000
# The standalone `mkdocs` compose service publishes on this host port (the
# devenv's own MkDocs uses MKDOCS_PORT above).
MKDOCS_SERVE_PORT=8001

# ---------------------------------------------------------------------------
# Jekyll
# ---------------------------------------------------------------------------
JEKYLL_PORT=4000

# ---------------------------------------------------------------------------
# The fleet's container plane (docs/CONTAINERS.md)
#
# Every submodule runs as its OWN compose project and joins one shared network,
# so they can all be up at once and reach `db` / `redis` by service name. The
# project name is PINNED: without it compose names the project after the
# directory, and a git worktree silently gets its own set of volumes.
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=fleet
FLEET_NETWORK=fleet
# Password for the per-project roles on the shared Postgres. A dev default, on
# a loopback-only port — but it IS the password for six projects' databases, so
# set your own here rather than relying on it.
FLEET_DB_PASSWORD=fleetdev

# ---------------------------------------------------------------------------
# Harness Console (docs/HARNESS-OPS.md) — loopback-only port; set the token to
# require `Authorization: Bearer` on the API when exposing it beyond localhost
# ---------------------------------------------------------------------------
CONSOLE_PORT=4001
#DASH_CONSOLE_TOKEN=
# The console answers on loopback hostnames only (a DNS-rebinding guard — a bind
# address alone does not stop a hostile page resolving its own name to 127.0.0.1).
# Name any other hostname you front it with, comma-separated, and set the token too.
#DASH_CONSOLE_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Phoenix (LLM observability — trace store for the fleet's agent runs)
# ---------------------------------------------------------------------------
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# ---------------------------------------------------------------------------
# Observability — the LOG and METRICS planes (profile: elk). Phoenix above is
# the third (traces); the Harness Console's Observe tab embeds all three.
# Every port is bound to 127.0.0.1 and nothing here ever runs in CI, which is
# what makes the security-off Elasticsearch and anonymous Grafana acceptable.
# Full doc: docs/OBSERVABILITY.md
# ---------------------------------------------------------------------------
# Image versions — the contract lives in _data/fleet.yml `observability:`;
# these defaults must match it (test_observe_contract.py checks). Elastic
# publishes no floating major/minor tag, so its pin is exact.
ELASTIC_VERSION=9.5.3
GRAFANA_VERSION=12.4
ES_PORT=9200
KIBANA_PORT=5601
LOGSTASH_BEATS_PORT=5044
LOGSTASH_HTTP_PORT=8088
GRAFANA_PORT=3001
# JVM heap for the two Java services. Elasticsearch needs roughly 2x its heap
# in RSS, so 512m is about 1.2 GB of the Docker VM — sized for a bench that is
# already running other projects' containers. Raise it before widening
# `dash observe ship --days`; if the container exits with code 137 it was
# OOM-killed, so lower it or give Docker Desktop more memory.
ES_HEAP=512m
LS_HEAP=256m

# Host directory holding this machine's Claude Code transcripts. The console
# mounts it read-only for `dash lake sessions` and `lake export --local`;
# without it those two commands find nothing and say so.
#CLAUDE_HOME=~/.claude

# ---------------------------------------------------------------------------
# Wiki.js
# ---------------------------------------------------------------------------
WIKI_PORT=3000
WIKI_DB_USER=wikijs
WIKI_DB_PASS=wikijsrocks
WIKI_DB_NAME=wiki
WIKI_ADMIN_EMAIL=admin@example.com
WIKI_SITE_URL=http://localhost:3000
WIKI_UPGRADE_COMPANION=0

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_PORT=5432

# ---------------------------------------------------------------------------
# Redis (optional, profile: full)
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# pgAdmin (optional, profile: admin)
# ---------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# API Keys (add your own, never commit real values)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# GITHUB_TOKEN=

# npm automation token (publish scope) — publishes templates/*/package.json kits via
# .github/workflows/publish-kits.yml. Hub-only GitHub Actions secret; never commit a value.
NPM_TOKEN=
