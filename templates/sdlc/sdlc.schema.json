{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bamr87/bamr87/blob/main/templates/sdlc/sdlc.schema.json",
  "title": "sdlc/v1 — the per-repo SDLC declaration (.github/sdlc.yml)",
  "description": "UPS-WORK-01. Decisions D1 (Issues backlog by default), D2 (ADR path), D5 (release-please type) and D6 (repo types) are encoded here. Unknown top-level keys are rejected so typos fail loudly.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "tier",
    "backlog",
    "modules"
  ],
  "properties": {
    "schema": {
      "const": "sdlc/v1"
    },
    "type": {
      "enum": [
        "app",
        "library",
        "site",
        "docs",
        "demo",
        "control-plane",
        "fork"
      ]
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "app",
          "api",
          "lib",
          "cli",
          "ext",
          "site",
          "content",
          "hub",
          "fork"
        ]
      },
      "description": "UPS kinds. `hub` marks the control plane; no spec row targets it yet, so the control plane is checked as `site`. Default by type: app→[app], library→[lib], site→[site], docs→[content], demo→[site], control-plane→[site, hub], fork→[fork]."
    },
    "tier": {
      "enum": [
        "active",
        "maintenance",
        "experiment",
        "archived"
      ]
    },
    "backlog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "issues",
            "file"
          ]
        },
        "file": {
          "enum": [
            "BACKLOG.md",
            "_data/backlog.yml"
          ]
        },
        "mirror_to_issues": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "file"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "file"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "file"
              ]
            },
            {
              "properties": {
                "mirror_to_issues": {
                  "const": true
                }
              },
              "required": [
                "mirror_to_issues"
              ]
            }
          ]
        }
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spec_driven": {
          "type": "boolean"
        },
        "adr": {
          "type": "boolean"
        },
        "features": {
          "type": "boolean"
        },
        "issue_autopilot": {
          "type": "boolean"
        },
        "content_queue": {
          "type": "boolean"
        },
        "ai_lanes": {
          "type": "boolean"
        }
      }
    },
    "adr_path": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
      "default": "docs/adr"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "simple",
            "node",
            "python",
            "ruby"
          ]
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UPS-[A-Z]+-\\d{2,}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "until": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "const": "fork"
            }
          }
        }
      },
      "then": {
        "required": [
          "release"
        ]
      }
    }
  ]
}
