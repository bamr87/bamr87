{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bamr87/bamr87/main/docs/agentic-patterns/patterns.schema.json",
  "title": "Agentic design patterns index",
  "description": "Machine index of docs/agentic-patterns/patterns/*.md. Each entry mirrors one chapter page's front matter, plus its path and the issues its Gaps section links.",
  "type": "object",
  "required": [
    "schema",
    "book",
    "patterns"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "patterns.schema.json"
    },
    "book": {
      "type": "string"
    },
    "generated_from": {
      "type": "string"
    },
    "patterns": {
      "type": "array",
      "minItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "chapter",
          "title",
          "book_pages",
          "status",
          "evidence_repos",
          "last_verified",
          "owner_bot",
          "path",
          "linked_issues"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADP-[0-9]{2}$"
          },
          "chapter": {
            "type": "integer",
            "minimum": 0,
            "maximum": 21
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "book_pages": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proven",
              "partial",
              "gap"
            ]
          },
          "evidence_repos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^bamr87/[A-Za-z0-9._-]+$"
            }
          },
          "last_verified": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "owner_bot": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^docs/agentic-patterns/patterns/[0-9]{2}-[a-z0-9-]+\\.md$"
          },
          "linked_issues": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^bamr87/[A-Za-z0-9._-]+#[0-9]+$"
            }
          }
        }
      }
    }
  }
}
