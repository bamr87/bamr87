{
	// The fleet workspace — the single development environment for the zer0-mistakes family and its tools.
	// Every folder carries the same .vscode convention (fleet-vscode/v1; see any repo's .vscode/README.md):
	// tasks.json runs (Serve / Stop / Build / Verify / Lint / Test / Claude: session), launch.json debugs.
	// Personal editor preferences live HERE, not in the repos' settings.json, so they apply across all twelve
	// folders and stay out of version control.
	"folders": [
		{
			"path": "lifehacker.dev"
		},
		{
			"path": "bash-365.com"
		},
		{
			"path": "zer0-mistakes"
		},
		{
			"path": "ai-world-view.github.io"
		},
		{
			"name": "year-of-ai",
			"path": "year-of-ai/year-of-ai.github.io"
		},
		{
			"path": "irony-works"
		},
		{
			"path": "it-journey"
		},
		{
			"path": "gitorio"
		},
		{
			"path": "zer0-CMS"
		},
		{
			"path": "zer0-image-generator"
		},
		{
			"path": "aieo"
		},
		{
			"path": "SCHEMA"
		}
	],
	"settings": {
		// Editor preferences (carried over from the old zer0-mistakes / it-journey .vscode/settings.json).
		"editor.fontSize": 14,
		"editor.lineHeight": 26,
		"editor.minimap.enabled": false,
		"editor.tabCompletion": "on",
		"editor.wordBasedSuggestions": "matchingDocuments",
		"editor.quickSuggestions": { "other": true, "comments": true, "strings": true },
		"files.autoSave": "afterDelay",
		"files.autoSaveDelay": 1000,
		"markdown.preview.breaks": true,
		"markdown.preview.linkify": true,
		// Window-scoped tool settings (a folder settings.json cannot apply these in a multi-root workspace).
		"containers.composeCommand": "docker compose",
		"shellcheck.useWorkspaceRootAsCwd": true,
		"yaml.format.enable": true,
		"yaml.validate": true
	},
	"extensions": {
		"recommendations": [
			"anthropic.claude-code",
			"editorconfig.editorconfig",
			"github.vscode-github-actions",
			"github.vscode-pull-request-github",
			"ms-azuretools.vscode-containers",
			"redhat.vscode-yaml",
			"davidanson.vscode-markdownlint",
			"streetsidesoftware.code-spell-checker",
			"timonwong.shellcheck"
		]
	}
}
